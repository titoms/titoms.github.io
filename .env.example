# Copy this file to .env and fill in your values.
# Set these same variables in Cloudflare Pages > Settings > Environment Variables for production.

# Beehiiv — Publication ID from Beehiiv dashboard > Settings > Publication
PUBLIC_BEEHIIV_PUBLICATION_ID=pub_REPLACE_WITH_YOUR_ID

# Cloudflare Web Analytics — token from CF dashboard > Analytics & Logs > Web Analytics
PUBLIC_CF_ANALYTICS_TOKEN=REPLACE_WITH_YOUR_CF_TOKEN
