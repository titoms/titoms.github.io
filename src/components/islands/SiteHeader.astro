---
import { BOOK_CALL_URL } from "../../config/constants";
import { getLocalizedPath, useTranslations } from "../../i18n/ui";

type LanguageLink = { locale: string; href: string; active: boolean };

interface Props {
  locale?: string;
  languageLinks?: LanguageLink[];
  currentPath?: string;
}

const {
  locale = "en",
  languageLinks = [],
  currentPath = "/",
} = Astro.props as Props;

const t = useTranslations(locale);
const localePrefix = locale === "en" ? "" : `/${locale}`;
const bookCallUrl = getLocalizedPath(BOOK_CALL_URL, locale);

const NAV_ORDER = [
  { id: "home", key: "nav.home", href: "/" },
  { id: "services", key: "nav.services", href: "/services/" },
  { id: "projects", key: "nav.projects", href: "/projects/" },
  { id: "blog", key: "nav.blog", href: "/blog/" },
  { id: "about", key: "nav.about", href: "/about/" },
  { id: "contact", key: "nav.contact", href: "/contact/" },
];

const normalizePath = (path: string) => {
  if (path === "/") return path;
  return path.replace(/\/+$/, "");
};

const isActiveLink = (href: string, pathname: string) => {
  const normalizedHref = normalizePath(href);
  const normalizedPathname = normalizePath(pathname);

  if (normalizedHref === "/" || /^\/(fr|es)$/.test(normalizedHref)) {
    return normalizedPathname === normalizedHref;
  }

  return normalizedPathname === normalizedHref || normalizedPathname.startsWith(`${normalizedHref}/`);
};

const mainNavLabel = t("nav.mainNavigation") === "nav.mainNavigation" ? "Main navigation" : t("nav.mainNavigation");
const mobileNavLabel = t("nav.mobileNavigation") === "nav.mobileNavigation" ? "Mobile navigation" : t("nav.mobileNavigation");
---

<header class="fixed top-0 z-50 w-full border-b border-border bg-primary/85 backdrop-blur-xl">
  <div class="mx-auto flex w-full max-w-site items-center justify-between px-6 py-4 sm:px-8 lg:px-10">
    <a href={localePrefix || "/"} class="flex items-center gap-3 font-display text-lg font-bold text-white">
      <img src="/favicon-32x32.png" alt="" width="32" height="32" decoding="async" class="h-9 w-9 shrink-0 object-contain" />
      <span>fullstackchris<span class="text-accent">.dev</span></span>
    </a>

    <nav class="hidden items-center gap-6 min-[900px]:flex" aria-label={mainNavLabel}>
      {NAV_ORDER.map((link) => {
        const href = `${localePrefix}${link.href}`;
        const active = isActiveLink(href, currentPath);
        return (
          <a href={href} aria-current={active ? "page" : undefined} class:list={["nav-link text-sm font-medium transition-colors", active ? "nav-link--active text-white" : "text-secondary hover:text-white"]}>
            {t(link.key)}
          </a>
        );
      })}
      <a href={bookCallUrl} class="btn-primary-animated inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-sm border px-3.5 py-2.5 font-body text-sm font-semibold leading-none no-underline transition-[transform,background,border-color,box-shadow,color] duration-150 ease-out focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
        {t("nav.bookCall")}
      </a>
      <div class="language-switcher" aria-label={t("languageSwitcher.label")}>
        {languageLinks.map(({ locale: linkLocale, href, active }) => (
          <a href={href} class="language-switcher__button" aria-current={active ? "true" : undefined} data-active={active ? "true" : undefined}>
            {linkLocale.toUpperCase()}
          </a>
        ))}
      </div>
    </nav>

    <button
      id="mobile-menu-button"
      type="button"
      class="relative z-[60] grid h-11 w-11 place-items-center rounded-lg border border-border bg-surface/80 transition-colors hover:bg-raised min-[900px]:hidden"
      aria-label={t("nav.openMenu")}
      aria-controls="mobile-navigation"
      aria-expanded="false"
      data-open-label={t("nav.openMenu")}
      data-close-label={t("nav.closeMenu")}
    >
      <span class="flex flex-col gap-[5px]" aria-hidden="true">
        <span class="mobile-menu-line block h-0.5 w-6 bg-white transition-all duration-300"></span>
        <span class="mobile-menu-line block h-0.5 w-6 bg-white transition-all duration-300"></span>
        <span class="mobile-menu-line block h-0.5 w-6 bg-white transition-all duration-300"></span>
      </span>
    </button>
  </div>
</header>

<div id="mobile-navigation" class="mobile-navigation fixed inset-0 z-40 min-[900px]:hidden bg-primary/95 backdrop-blur-xl" hidden inert>
  <nav class="flex min-h-[100dvh] flex-col items-center justify-center gap-7 px-6 pb-10 pt-24" aria-label={mobileNavLabel}>
    {NAV_ORDER.map((link) => {
      const href = `${localePrefix}${link.href}`;
      const active = isActiveLink(href, currentPath);
      return (
        <a href={href} aria-current={active ? "page" : undefined} class:list={["nav-link text-2xl font-medium transition-colors", active ? "nav-link--active text-white" : "text-secondary hover:text-white"]}>
          {t(link.key)}
        </a>
      );
    })}
    <a href={bookCallUrl} class="btn-primary-animated inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md border px-7 py-4 font-body text-xl font-semibold leading-none no-underline transition-[transform,background,border-color,box-shadow,color] duration-150 ease-out focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
      {t("nav.bookCall")}
    </a>
    <div class="language-switcher mt-3" aria-label={t("languageSwitcher.label")}>
      {languageLinks.map(({ locale: linkLocale, href, active }) => (
        <a href={href} class="language-switcher__button" aria-current={active ? "true" : undefined} data-active={active ? "true" : undefined}>
          {linkLocale.toUpperCase()}
        </a>
      ))}
    </div>
  </nav>
</div>

<style is:inline>
  .mobile-navigation {
    opacity: 0;
    transform: translateX(100%);
    transition: opacity 300ms ease, transform 300ms ease;
  }

  .mobile-navigation[data-open="true"] {
    opacity: 1;
    transform: translateX(0);
  }

  #mobile-menu-button[data-open="true"] .mobile-menu-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  #mobile-menu-button[data-open="true"] .mobile-menu-line:nth-child(2) {
    opacity: 0;
  }

  #mobile-menu-button[data-open="true"] .mobile-menu-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-navigation {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const button = document.getElementById("mobile-menu-button");
    const drawer = document.getElementById("mobile-navigation");
    if (!button || !drawer) return;

    const getFocusable = () => Array.from(drawer.querySelectorAll("a[href], button:not([disabled])"));
    let previousOverflow = "";
    let closeTimer = 0;

    const setOpen = (open) => {
      window.clearTimeout(closeTimer);
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? button.dataset.closeLabel : button.dataset.openLabel);
      button.dataset.open = String(open);

      if (open) {
        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = "hidden";
        drawer.hidden = false;
        drawer.inert = false;
        requestAnimationFrame(() => {
          drawer.dataset.open = "true";
          getFocusable()[0]?.focus();
        });
        return;
      }

      document.body.style.overflow = previousOverflow;
      drawer.dataset.open = "false";
      drawer.inert = true;
      closeTimer = window.setTimeout(() => {
        drawer.hidden = true;
      }, 300);
      button.focus();
    };

    const isOpen = () => button.getAttribute("aria-expanded") === "true";
    button.addEventListener("click", () => setOpen(!isOpen()));
    drawer.addEventListener("click", (event) => {
      if (event.target.closest("a")) setOpen(false);
    });
    window.addEventListener("keydown", (event) => {
      if (!isOpen() || event.key !== "Escape") return;
      event.preventDefault();
      setOpen(false);
    });
  })();
</script>
