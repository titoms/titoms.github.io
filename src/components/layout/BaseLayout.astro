---
import '../../styles/global.css';
import { CF_ANALYTICS_TOKEN } from '../../config/constants';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: object | object[];
  gscVerification?: string;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = 'https://fullstackchris.dev/og-image.png',
  jsonLd,
  gscVerification,
} = Astro.props;

const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const cfToken = CF_ANALYTICS_TOKEN.startsWith('REPLACE') ? null : CF_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="fullstackchris.dev" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Search Console verification (pass gscVerification prop if using meta tag method) -->
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}

    <!-- JSON-LD structured data -->
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Page-specific head content (scripts, stylesheets, etc.) -->
    <slot name="head" />
  </head>
  <body>
    <slot />

    <!-- Cloudflare Web Analytics -->
    {cfToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfToken })}
      />
    )}
  </body>
</html>
