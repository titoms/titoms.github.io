---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from './BaseLayout.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from '../islands/SiteHeader.astro';
import { locales, defaultLocale, stripLocalePrefix } from '../../i18n/ui';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: object | object[];
  gscVerification?: string;
}

const props = Astro.props;
const currentLocale = Astro.currentLocale ?? defaultLocale;
const barePath = stripLocalePrefix(Astro.url.pathname).replace(/^\//, '');
const languageLinks = locales.map((locale) => ({
  locale,
  href: getRelativeLocaleUrl(locale, barePath),
  active: locale === currentLocale,
}));
---

<BaseLayout {...props}>
  <slot name="head" slot="head" />
  <SiteHeader locale={currentLocale} languageLinks={languageLinks} currentPath={Astro.url.pathname} />
  <main>
    <slot />
  </main>
  <SiteFooter locale={currentLocale} languageLinks={languageLinks} />
</BaseLayout>
