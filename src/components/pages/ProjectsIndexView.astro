---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import PageLayout from '../layout/PageLayout.astro';
import { BOOK_CALL_URL } from '../../config/constants';
import { getProjects } from '../../config/projects';
import { useTranslations, defaultLocale } from '../../i18n/ui';
import { projectsIndex } from './content/projectsIndex';

const locale = (Astro.currentLocale ?? defaultLocale) as 'en' | 'fr' | 'es';
const t = useTranslations(locale);
const c = projectsIndex[locale];
const localePrefix = locale === 'en' ? '' : `/${locale}`;
const allProjects = getProjects(locale);

const sectionMax = "mx-auto w-full max-w-site px-6 sm:px-8 lg:px-10";

// Category mapping — drives the filter chips
const projectCats: Record<string, string> = {
  'keevo':        'tools',
  'edumation':    'apps',
  'railguessr':   'games',
  'singuessr':    'games',
  'fuchibol-hub': 'apps',
  'fresh-win':    'apps',
};

// Window URL labels for the mockup chrome
const projectUrls: Record<string, string> = {
  'keevo':        'keevo.app — Editor',
  'edumation':    'edumation.app',
  'railguessr':   'railguessr.com',
  'singuessr':    'singuessr.com',
  'fuchibol-hub': 'fuchibo.app',
  'fresh-win':    'fresh.win',
};

// The featured card slug
const featuredSlug = 'keevo';
const featured = allProjects.find(p => p.slug === featuredSlug)!;
const rest = allProjects.filter(p => p.slug !== featuredSlug);

// Filter counts
const counts = {
  all:   allProjects.length,
  apps:  allProjects.filter(p => projectCats[p.slug] === 'apps').length,
  tools: allProjects.filter(p => projectCats[p.slug] === 'tools').length,
  games: allProjects.filter(p => projectCats[p.slug] === 'games').length,
};

// Tech stack strip
const stackBadges = ['React', 'Next.js', 'TypeScript', 'Node.js', 'Electron', 'PostgreSQL', 'Supabase', 'Web Audio', 'On-device AI'];
const accentBadge = 'On-device AI';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Projects — fullstackchris.dev",
  url: "https://fullstackchris.dev/projects/",
  description: c.jsonLd.description,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: allProjects.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: `https://fullstackchris.dev/projects/${p.slug}/`,
      name: p.name,
    })),
  },
};
---

<PageLayout
  title={c.meta.title}
  description={c.meta.description}
  jsonLd={jsonLd}
>

  <!-- ── HERO ──────────────────────────────────────────────────────────── -->
  <section
    class="proj-hero relative overflow-hidden isolation-isolate border-b border-border"
    data-parallax-scene
    style="padding: 0 0 64px;"
  >
    <!-- Animated blob field -->
    <div class="bg-field" aria-hidden="true">
      <span class="blob blob-1"></span>
      <span class="blob blob-2"></span>
      <span class="blob blob-3"></span>
    </div>

    <!-- Grid overlay -->
    <div class="absolute inset-0 pointer-events-none z-[1] opacity-40"
         style="background-image:linear-gradient(var(--border) 1px,transparent 1px),linear-gradient(90deg,var(--border) 1px,transparent 1px);background-size:64px 64px;"
         aria-hidden="true"></div>

    <!-- Floating tech pills (desktop only) -->
    <span class="float-pill" style="top:38px;right:8%;--dur:6.6s;--del:0s;" data-depth="0.06">
      <span class="dot" style="background:#61dafb;"></span>React
    </span>
    <span class="float-pill" style="top:150px;right:22%;--dur:8.3s;--del:.7s;" data-depth="0.045">
      <span class="mk" style="background:#3178c6;">TS</span>TypeScript
    </span>
    <span class="float-pill" style="bottom:80px;right:12%;--dur:7.4s;--del:1.1s;" data-depth="0.07">
      <span class="dot" style="background:#6cc24a;"></span>Node.js
    </span>

    <div class={`${sectionMax} relative z-[3]`} style="padding-top:clamp(7rem,12vh,10rem);">
      <!-- Breadcrumb -->
      <nav class="reveal r1 flex items-center gap-2 font-mono text-xs text-low mb-6">
        <a href={localePrefix || '/'} class="text-secondary transition-colors hover:text-white">{t('nav.home')}</a>
        <span class="opacity-50">/</span>
        <span class="text-secondary">{c.breadcrumbCurrent}</span>
      </nav>

      <!-- Eyebrow -->
      <span class="reveal r2 inline-flex items-center gap-[10px] font-mono text-[0.7rem] font-medium tracking-[0.16em] uppercase text-secondary px-[14px] py-[7px] border border-strong rounded-md" style="background:rgba(26,26,32,0.55);backdrop-filter:blur(8px);">
        <span class="pulse-dot"></span>{c.eyebrow}
      </span>

      <!-- Headline -->
      <h1 class="reveal r3 font-display font-bold leading-[0.98] tracking-[-0.035em] mt-5 mb-4" style="font-size:clamp(2.6rem,5.6vw,4.4rem);max-width:18ch;">
        {c.h1Lead}<span style="color:var(--accent-400)">{c.h1Accent}</span>
      </h1>

      <!-- Lead -->
      <p class="reveal r4 text-secondary leading-7" style="max-width:52ch;font-size:clamp(1rem,1.4vw,1.1rem);">
        {c.lead}
      </p>

      <!-- Stats -->
      <div class="reveal r5 stats-row flex flex-nowrap gap-6 sm:gap-12 mt-7 pt-5 border-t border-border">
        <div class="stat">
          <div class="font-display text-[1.2rem] sm:text-[1.8rem] font-bold text-white leading-none" style="font-variant-numeric:tabular-nums;letter-spacing:-0.02em;">
            <span class="count" data-count="5">0</span>
          </div>
          <div class="font-mono text-[0.55rem] sm:text-[0.7rem] tracking-[0.08em] sm:tracking-[0.1em] uppercase text-low mt-[2px]">{c.stats.shippedProducts}</div>
        </div>
        <div class="stat">
          <div class="font-display text-[1.2rem] sm:text-[1.8rem] font-bold text-white leading-none" style="font-variant-numeric:tabular-nums;letter-spacing:-0.02em;">
            <span class="count" data-count="3">0</span>
          </div>
          <div class="font-mono text-[0.55rem] sm:text-[0.7rem] tracking-[0.08em] sm:tracking-[0.1em] uppercase text-low mt-[2px]">{c.stats.productDomains}</div>
        </div>
        <div class="stat">
          <div class="font-display text-[1.2rem] sm:text-[1.8rem] font-bold text-white leading-none" style="font-variant-numeric:tabular-nums;letter-spacing:-0.02em;">
            <span class="count" data-count="7000" data-suffix="h+">0</span>
          </div>
          <div class="font-mono text-[0.55rem] sm:text-[0.7rem] tracking-[0.08em] sm:tracking-[0.1em] uppercase text-low mt-[2px]">{c.stats.teachingWebDev}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FILTER + GRID ─────────────────────────────────────────────────── -->
  <section class="section" style="padding-top:0;">
    <div class={sectionMax}>

      <!-- Sticky filter bar -->
      <div class="flex items-center gap-3 flex-wrap py-5 sticky top-0 z-20 border-b border-border"
           style="background:rgba(13,13,16,0.82);backdrop-filter:blur(14px);"
           data-filter-bar>
        <span class="font-mono text-[0.7rem] tracking-[0.12em] uppercase text-low mr-2">{c.filter.label}</span>
        <button class="chip active" data-filter="all">{c.filter.all} <span class="c">{counts.all}</span></button>
        <button class="chip" data-filter="apps">{c.filter.apps} <span class="c">{counts.apps}</span></button>
        <button class="chip" data-filter="tools">{c.filter.tools} <span class="c">{counts.tools}</span></button>
        <button class="chip" data-filter="games">{c.filter.games} <span class="c">{counts.games}</span></button>
      </div>

      <!-- Project grid -->
      <div class="pgrid" data-stagger="90">

        <!-- Featured card -->
        <a
          class="pcard feature filterable"
          href={`${localePrefix}/projects/${featured.slug}/`}
          data-cats={projectCats[featured.slug] ?? 'apps'}
          data-reveal="scale"
        >
          <!-- Body -->
          <div class="pc-body">
            <span class="feature-flag">
              <span class="pulse-dot"></span>{c.featuredFlag}
            </span>
            <span class="pc-kind">{c.projectKinds[featured.slug]}</span>
            <div class="pc-title">{featured.name} <span class="ar">→</span></div>
            <p class="pc-desc">{featured.description}</p>
            <div class="pc-foot">
              <div class="pc-tags">
                {featured.tags.map((tag, i) => (
                  <span class={`badge${i === featured.tags.length - 1 ? ' badge-accent' : ''}`}>
                    {i === featured.tags.length - 1 && <span class="dot"></span>}
                    {tag.name}
                  </span>
                ))}
              </div>
            </div>
            <span class="pc-cta">{c.readCaseStudy}</span>
          </div>

          <!-- Mockup window -->
          <div class="pc-media">
            <div class="win">
              <div class="win-bar">
                <span class="traffic"><i></i><i></i><i></i></span>
                <span class="url">{projectUrls[featured.slug]}</span>
              </div>
              <div class="win-shot">
                {featured.image ? (
                  typeof featured.image === 'string'
                    ? <img src={featured.image} alt={featured.name} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" loading="eager" decoding="async" />
                    : <Image src={featured.image as ImageMetadata} alt={featured.name} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" loading="eager" decoding="async" />
                ) : (
                  <span style="position:relative;z-index:1;">{featured.name} — editor &amp; timeline</span>
                )}
                <span class="sheen"></span>
              </div>
            </div>
          </div>
        </a>

        <!-- Regular cards -->
        {rest.map((project) => (
          <a
            class="pcard filterable"
            href={`${localePrefix}/projects/${project.slug}/`}
            data-cats={projectCats[project.slug] ?? 'apps'}
            data-reveal="scale"
          >
            <!-- Mockup window -->
            <div class="pc-media">
              <div class="win">
                <div class="win-bar">
                  <span class="traffic"><i></i><i></i><i></i></span>
                  <span class="url">{projectUrls[project.slug] ?? project.slug + '.app'}</span>
                </div>
                <div class="win-shot">
                  {project.image ? (
                    typeof project.image === 'string'
                      ? <img src={project.image} alt={project.name} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" loading="lazy" decoding="async" />
                      : <Image src={project.image as ImageMetadata} alt={project.name} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" loading="lazy" decoding="async" />
                  ) : (
                    <span style="position:relative;z-index:1;">{project.name}</span>
                  )}
                  <span class="sheen"></span>
                </div>
              </div>
            </div>

            <!-- Body -->
            <div class="pc-body">
              <span class="pc-kind">{c.projectKinds[project.slug]}</span>
              <div class="pc-title">{project.name} <span class="ar">→</span></div>
              <p class="pc-desc">{project.description.slice(0, 140)}{project.description.length > 140 ? '…' : ''}</p>
              <div class="pc-foot">
                <div class="pc-tags">
                  {project.tags.slice(0, 3).map((tag) => (
                    <span class="badge">{tag.name}</span>
                  ))}
                </div>
              </div>
            </div>
          </a>
        ))}

        <p class="empty-note font-mono text-[0.9rem] text-low text-center col-span-full py-20" hidden>
          {c.emptyNote}
        </p>
      </div>
    </div>
  </section>

  <!-- ── STACK STRIP ────────────────────────────────────────────────────── -->
  <section class="section" style="padding-top:0;">
    <div class={sectionMax}>
      <div class="flex items-center justify-between gap-6 flex-wrap p-6 border border-border rounded-[var(--r-xl)]"
           style="background:var(--bg-1);"
           data-reveal="fade">
        <div style="min-width:200px;">
          <span class="font-mono text-[0.62rem] tracking-[0.18em] uppercase text-low">{c.toolbox.eyebrow}</span>
          <p class="text-secondary text-sm mt-2 leading-6" style="max-width:30ch;">{c.toolbox.description}</p>
        </div>
        <div class="flex flex-wrap gap-3 flex-1 justify-end">
          {stackBadges.map(name => (
            <span class={`badge${name === accentBadge ? ' badge-accent' : ''}`}>
              {name === accentBadge && <span class="dot"></span>}
              {name}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────────────── -->
  <section class="section" id="contact">
    <div class={sectionMax}>
      <div class="text-center border border-accent rounded-[var(--r-xl)] px-8 py-20"
           style="background:linear-gradient(150deg,var(--accent-soft) 0%,var(--bg-2) 55%);box-shadow:var(--glow);"
           data-reveal="scale">
        <span class="font-mono text-[0.62rem] tracking-[0.18em] uppercase text-accent">{c.cta.eyebrow}</span>
        <h2 class="font-display font-semibold leading-tight mt-4 mb-4 mx-auto"
            style="font-size:clamp(2rem,4vw,3rem);max-width:18ch;">
          {c.cta.h2}
        </h2>
        <p class="text-secondary leading-7 mb-8 mx-auto" style="max-width:46ch;">
          {c.cta.lead}
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a class="btn btn-primary-animated inline-flex items-center gap-2 rounded-md border px-6 py-3 font-display font-semibold text-[0.95rem] no-underline transition-all duration-200"
             href={`${localePrefix}/services/mvp-development/`}>
            {c.cta.primaryCta} <span>→</span>
          </a>
          <a class="btn-grad-hover btn-secondary inline-flex items-center gap-2 rounded-md border border-strong px-6 py-3 font-display font-semibold text-[0.95rem] text-secondary no-underline transition-all duration-200"
             href={`${localePrefix}/services/`}>
            {c.cta.secondaryCta}
          </a>
        </div>
      </div>
    </div>
  </section>

</PageLayout>

<style is:inline>
  .proj-hero { isolation: isolate; }
  .section { padding: 80px 0; }
  @media (max-width: 700px) { .section { padding: 56px 0; } }
</style>
