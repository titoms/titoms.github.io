---
import { Image } from 'astro:assets';
import PageLayout from '../layout/PageLayout.astro';
import { Button } from '../ui/Button';
import { Card } from '../ui/Card';
import { defaultLocale, type Locale } from '../../i18n/ui';
import humanCodersLogo from '../../assets/logo/png/logo-white.webp';
import TrainingLegalNotice from '../ui/TrainingLegalNotice.astro';

type Course = { slug: string; title: string; description: string; duration: string; audience: string[]; prerequisites: string[]; goals: string[]; skills: string[]; days: { title: string; modules: string[]; practice: string }[]; pedagogy: string[]; evaluation: string[]; materials: string[]; deliverables: string[]; adaptation: string; faq: [string, string][]; cta: string };
const locales: Locale[] = ['en', 'fr', 'es'];
const path = (l: Locale, slug = '') => `${l === defaultLocale ? '' : `/${l}`}/formations/${slug ? `${slug}/` : ''}`;
const contact = (l: Locale) => `${l === defaultLocale ? '' : `/${l}`}/contact/#schedule`;
const home = (l: Locale) => l === defaultLocale ? '/' : `/${l}/`;
const labels = {
  fr: { catalogue: 'Formations professionnelles', hero: 'Former pour mieux construire.', course: 'Formation professionnelle', home: 'Accueil', business: 'Bénéfices pour l’entreprise', audience: 'Public cible', prerequisites: 'Prérequis techniques', goals: 'Objectifs pédagogiques mesurables', skills: 'Compétences développées', programme: 'Programme indicatif', pedagogy: 'Modalités pédagogiques', evaluation: 'Modalités d’évaluation', materials: 'Matériel et environnement requis', deliverables: 'Livrables remis', adaptation: 'Adaptation en intra-entreprise', faq: 'FAQ spécifique', request: 'Demander un programme ou un devis', human: 'Formateur référencé chez Human Coders', humanText: 'Profil de formateur référencé publiquement chez Human Coders. Cette mention ne constitue ni une certification ni un partenariat exclusif.', humanLink: 'Voir le profil Human Coders', duration: 'Durée indicative : à confirmer avec le groupe et le contexte.', practice: 'TP et projet fil rouge' },
  en: { catalogue: 'Professional training', hero: 'Learn to build with more confidence.', course: 'Professional training', home: 'Home', business: 'Business benefits', audience: 'Who it is for', prerequisites: 'Technical prerequisites', goals: 'Measurable learning objectives', skills: 'Skills developed', programme: 'Indicative programme', pedagogy: 'Teaching methods', evaluation: 'Assessment', materials: 'Required setup', deliverables: 'Participant deliverables', adaptation: 'In-company adaptation', faq: 'Course FAQ', request: 'Request a programme or quote', human: 'Trainer listed with Human Coders', humanText: 'A publicly listed trainer profile with Human Coders. This is a factual listing, not a certification or an exclusive partnership.', humanLink: 'View the Human Coders profile', duration: 'Indicative duration: confirmed with the group and context.', practice: 'Labs and capstone' },
  es: { catalogue: 'Formación profesional', hero: 'Aprender para construir mejor.', course: 'Formación profesional', home: 'Inicio', business: 'Beneficios para la empresa', audience: 'Público objetivo', prerequisites: 'Requisitos técnicos', goals: 'Objetivos pedagógicos medibles', skills: 'Competencias desarrolladas', programme: 'Programa indicativo', pedagogy: 'Modalidades pedagógicas', evaluation: 'Evaluación', materials: 'Material y entorno necesario', deliverables: 'Entregables para participantes', adaptation: 'Adaptación para empresa', faq: 'Preguntas frecuentes', request: 'Solicitar programa o presupuesto', human: 'Formador incluido en Human Coders', humanText: 'Perfil de formador publicado en Human Coders. Es una referencia factual, no una certificación ni una colaboración exclusiva.', humanLink: 'Ver el perfil de Human Coders', duration: 'Duración orientativa: se confirma con el grupo y el contexto.', practice: 'Prácticas y proyecto transversal' },
} as const;

const build = (locale: Locale, slug: string): Course => {
  const en = locale === 'en'; const es = locale === 'es';
  const copy = {
    'react-typescript': {
      title: en ? 'React and TypeScript training' : es ? 'Formación React y TypeScript' : 'Formation React et TypeScript',
      description: en ? 'Build maintainable, typed, accessible and testable React interfaces.' : es ? 'Construir interfaces React mantenibles, tipadas, accesibles y testeables.' : 'Construire une interface React maintenable, typée, accessible et testable.', duration: en ? 'Indicative proposal: 3 days' : es ? 'Propuesta indicativa: 3 días' : 'Proposition indicative : 3 jours',
      audience: en ? ['JavaScript developers professionalising React', 'Frontend teams aligning patterns and quality'] : es ? ['Desarrolladores JavaScript que profesionalizan React', 'Equipos frontend que alinean patrones y calidad'] : ['Développeurs JavaScript qui professionnalisent React', 'Équipes frontend qui harmonisent leurs patterns et leur qualité'],
      prerequisites: en ? ['Modern JavaScript and async/await', 'Some experience building web interfaces'] : es ? ['JavaScript moderno y async/await', 'Experiencia creando interfaces web'] : ['JavaScript moderne et async/await', 'Première expérience d’interface web'],
      goals: en ? ['Model data, props, state and events with TypeScript', 'Structure composable React components', 'Connect an API and handle async states', 'Write useful tests and identify maintenance risks'] : es ? ['Modelar datos, props, estado y eventos con TypeScript', 'Estructurar componentes React composables', 'Conectar APIs y gestionar estados asíncronos', 'Escribir pruebas e identificar riesgos de mantenimiento'] : ['Modéliser les données, props, états et événements avec TypeScript', 'Structurer des composants React composables', 'Connecter une API et traiter les états asynchrones', 'Écrire des tests utiles et identifier les risques'],
      skills: en ? ['TypeScript applied to React', 'Components, hooks and architecture', 'Forms, APIs, validation and errors', 'Accessibility, performance, tests and CI'] : es ? ['TypeScript aplicado a React', 'Componentes, hooks y arquitectura', 'Formularios, APIs, validación y errores', 'Accesibilidad, rendimiento, pruebas y CI'] : ['TypeScript appliqué à React', 'Composants, hooks et architecture', 'Formulaires, API, validation et erreurs', 'Accessibilité, performance, tests et CI'],
      days: en ? [{ title: 'Day 1 — Foundations and components', modules: ['Useful TypeScript: props, state and events', 'Components, hooks, composition and project organisation'], practice: 'Build the interface of a business application.' }, { title: 'Day 2 — A real application', modules: ['Forms, validation and API communication', 'Loading, errors, async state, local and shared state', 'Accessibility and performance'], practice: 'Extend the application with API, forms and loading states.' }, { title: 'Day 3 — Quality and maintenance', modules: ['Component tests and refactoring', 'Error handling and maintainable structure', 'Introduction to CI'], practice: 'Harden and test the complete application.' }] : es ? [{ title: 'Día 1 — Fundamentos y componentes', modules: ['TypeScript útil: props, estado y eventos', 'Componentes, hooks, composición y organización'], practice: 'Construir la interfaz de una aplicación de negocio.' }, { title: 'Día 2 — Aplicación real', modules: ['Formularios, validación y APIs', 'Carga, errores, estado local y compartido', 'Accesibilidad y rendimiento'], practice: 'Ampliar la aplicación con API, formularios y estados de carga.' }, { title: 'Día 3 — Calidad y mantenimiento', modules: ['Pruebas de componentes y refactorización', 'Errores y estructura mantenible', 'Introducción a CI'], practice: 'Hacer fiable y probar la aplicación completa.' }] : [{ title: 'Jour 1 — Fondations et composants', modules: ['TypeScript utile : props, états et événements', 'Composants, hooks, composition et organisation'], practice: 'Construire l’interface d’une application métier.' }, { title: 'Jour 2 — Application réelle', modules: ['Formulaires, validation et API', 'Chargement, erreurs, états local et partagé', 'Accessibilité et performance'], practice: 'Enrichir l’application avec API et formulaires.' }, { title: 'Jour 3 — Qualité et maintenance', modules: ['Tests de composants et refactoring', 'Erreurs et structure maintenable', 'Introduction à la CI'], practice: 'Fiabiliser et tester l’application complète.' }],
    },
    'node-backend': {
      title: en ? 'Node.js and backend training' : es ? 'Formación Node.js y backend' : 'Formation Node.js et backend', description: en ? 'Design clear, testable and operable Node.js APIs with TypeScript and PostgreSQL.' : es ? 'Diseñar APIs backend claras, testeables y operables con Node.js, TypeScript y PostgreSQL.' : 'Concevoir une API claire, testable et exploitable avec Node.js, TypeScript et PostgreSQL.', duration: en ? 'Indicative proposal: 3 days' : es ? 'Propuesta indicativa: 3 días' : 'Proposition indicative : 3 jours',
      audience: en ? ['Frontend developers taking ownership of a backend', 'Teams building or inheriting a Node.js API'] : es ? ['Desarrolladores frontend que asumen un backend', 'Equipos que construyen o mantienen una API Node.js'] : ['Développeurs frontend qui prennent en charge un backend', 'Équipes qui construisent ou reprennent une API Node.js'], prerequisites: en ? ['Working JavaScript or TypeScript', 'Basic HTTP and relational database knowledge'] : es ? ['JavaScript o TypeScript operativo', 'Nociones de HTTP y bases relacionales'] : ['JavaScript ou TypeScript opérationnel', 'Notions de HTTP et de bases relationnelles'], goals: en ? ['Design REST routes with contracts and validation', 'Separate routes, services, data access and errors', 'Persist PostgreSQL data and control access', 'Test, containerise and prepare operations'] : es ? ['Diseñar rutas REST con contratos y validación', 'Separar rutas, servicios, datos y errores', 'Persistir PostgreSQL y controlar accesos', 'Probar, contenerizar y preparar la operación'] : ['Concevoir des routes REST avec contrats et validation', 'Séparer routes, services, données et erreurs', 'Persister PostgreSQL et contrôler les accès', 'Tester, conteneuriser et préparer l’exploitation'], skills: en ? ['Asynchronous Node.js, Express and TypeScript', 'HTTP/REST, middleware and validation', 'PostgreSQL, services and access control', 'Tests, logs, secrets, Docker and CI/CD'] : es ? ['Node.js asíncrono, Express y TypeScript', 'HTTP/REST, middlewares y validación', 'PostgreSQL, servicios y control de acceso', 'Pruebas, logs, secretos, Docker y CI/CD'] : ['Node.js asynchrone, Express et TypeScript', 'HTTP/REST, middlewares et validation', 'PostgreSQL, services et contrôle d’accès', 'Tests, logs, secrets, Docker et CI/CD'],
      days: en ? [{ title: 'Day 1 — Backend architecture', modules: ['Node.js async behaviour; HTTP and REST', 'Express and TypeScript: routes, middleware, validation and errors'], practice: 'Start a business API with contracts and validation.' }, { title: 'Day 2 — Data and security', modules: ['PostgreSQL and data access; service architecture', 'Authentication, authorisation and common security'], practice: 'Complete a persistent API with access controls.' }, { title: 'Day 3 — Quality and deployment', modules: ['Unit and integration tests; logs and errors', 'Environment variables, secrets, Docker and CI/CD'], practice: 'Test, containerise and prepare the API for production.' }] : es ? [{ title: 'Día 1 — Arquitectura backend', modules: ['Node.js asíncrono; HTTP y REST', 'Express y TypeScript: rutas, middlewares, validación y errores'], practice: 'Iniciar una API de negocio con contratos y validación.' }, { title: 'Día 2 — Datos y seguridad', modules: ['PostgreSQL y acceso a datos; arquitectura de servicios', 'Autenticación, autorización y seguridad habitual'], practice: 'Completar una API persistente con controles de acceso.' }, { title: 'Día 3 — Calidad y despliegue', modules: ['Pruebas unitarias e integración; logs y errores', 'Variables, secretos, Docker y CI/CD'], practice: 'Probar, contenerizar y preparar la API.' }] : [{ title: 'Jour 1 — Architecture backend', modules: ['Node.js asynchrone ; HTTP et REST', 'Express et TypeScript : routes, middlewares, validation et erreurs'], practice: 'Démarrer une API métier avec contrats et validation.' }, { title: 'Jour 2 — Données et sécurité', modules: ['PostgreSQL et accès aux données ; services', 'Authentification, autorisation et sécurité courante'], practice: 'Compléter une API persistante avec contrôles d’accès.' }, { title: 'Jour 3 — Qualité et déploiement', modules: ['Tests unitaires et intégration ; logs et erreurs', 'Variables, secrets, Docker et CI/CD'], practice: 'Tester, conteneuriser et préparer l’API.' }],
    },
    'ia-developpeurs': {
      title: en ? 'AI and development agents training' : es ? 'Formación IA y agentes de desarrollo' : 'Formation IA et agents de développement', description: en ? 'Use Claude Code, Codex and development agents with context, permissions, tests and human review.' : es ? 'Usar Claude Code, Codex y agentes con contexto, permisos, pruebas y revisión humana.' : 'Utiliser Claude Code, Codex et les agents avec contexte, permissions, tests et revue humaine.', duration: en ? 'Indicative proposal: 2 days' : es ? 'Propuesta indicativa: 2 días' : 'Proposition indicative : 2 jours',
      audience: en ? ['Developers and technical leads', 'Teams setting guardrails for coding agents'] : es ? ['Desarrolladores y referentes técnicos', 'Equipos que establecen límites para agentes'] : ['Développeurs et référents techniques', 'Équipes qui cadrent l’usage des agents de code'], prerequisites: en ? ['Comfort with Git and project tests', 'No prior Claude Code or Codex experience required'] : es ? ['Saber usar Git y las pruebas del proyecto', 'No se requiere experiencia con Claude Code o Codex'] : ['Savoir utiliser Git et lancer les tests', 'Aucune expérience préalable avec Claude Code ou Codex'], goals: en ? ['Distinguish assistant, agent and harness', 'Prepare a repository and useful context', 'Break work into supervised steps', 'Assess quality, risk and maintainability'] : es ? ['Distinguir asistente, agente y harness', 'Preparar repositorio y contexto útil', 'Dividir el trabajo en pasos supervisables', 'Evaluar calidad, riesgo y mantenibilidad'] : ['Distinguer assistant, agent et harness', 'Préparer dépôt et contexte utiles', 'Découper une tâche en étapes supervisables', 'Évaluer qualité, risques et maintenabilité'], skills: en ? ['Repository instructions and context', 'Claude Code, Codex and alternatives', 'Permissions, secrets, worktrees and isolation', 'Tests, branches, PRs, checkpoints and recovery'] : es ? ['Instrucciones y contexto del repositorio', 'Claude Code, Codex y alternativas', 'Permisos, secretos, worktrees y aislamiento', 'Pruebas, ramas, PR, checkpoints y recuperación'] : ['Instructions et contexte projet', 'Claude Code, Codex et alternatives', 'Permissions, secrets, worktrees et isolation', 'Tests, branches, PR, checkpoints et reprise'],
      days: en ? [{ title: 'Day 1 — Effective AI-assisted development', modules: ['Assistant, agent, harness; Claude Code, Codex and alternatives', 'CLAUDE.md, AGENTS.md, planning and task slicing', 'Permissions, access and tool limits'], practice: 'Implement a feature with a supervised agent.' }, { title: 'Day 2 — Reliability and teamwork', modules: ['Tests, review, branches, worktrees and pull requests', 'Isolation, permissions, secrets and inherited configuration', 'Checkpoints, supervision and recovery'], practice: 'Establish an agent → tests → review → PR workflow.' }] : es ? [{ title: 'Día 1 — Desarrollo eficaz con agentes IA', modules: ['Asistente, agente, harness; Claude Code, Codex y alternativas', 'CLAUDE.md, AGENTS.md, planificación y división', 'Permisos, accesos y límites'], practice: 'Implementar una funcionalidad con un agente supervisado.' }, { title: 'Día 2 — Fiabilidad y equipo', modules: ['Pruebas, revisión, ramas, worktrees y pull requests', 'Aislamiento, permisos, secretos y configuración heredada', 'Checkpoints, supervisión y recuperación'], practice: 'Crear un flujo agente → pruebas → revisión → PR.' }] : [{ title: 'Jour 1 — Développer efficacement avec les agents IA', modules: ['Assistant, agent, harness ; Claude Code, Codex et alternatives', 'CLAUDE.md, AGENTS.md, planification et découpage', 'Permissions, accès et limites'], practice: 'Implémenter une fonctionnalité avec un agent supervisé.' }, { title: 'Jour 2 — Fiabilité et travail en équipe', modules: ['Tests, revue, branches, worktrees et pull requests', 'Isolation, permissions, secrets et configurations héritées', 'Checkpoints, supervision et reprise'], practice: 'Mettre en place un workflow agent → tests → revue → PR.' }],
    },
  }[slug];
  const generic = en ? { pedagogy: ['Short demonstrations, guided practice and group review', 'Examples close to the business context without unnecessary libraries', 'A capstone split into verifiable slices'], evaluation: ['Initial positioning', 'Lab reviews with explicit criteria', 'Final assessment: explain, fix and deliver a tested slice'], materials: ['Node.js LTS, editor, browser and Git', 'Access to the training repository and isolated environment'], deliverables: ['Capstone repository and completed exercises', 'Practical checklist and written next steps'], adaptation: 'The domain, pace, level and tooling are adapted during scoping.', faq: [['Are the displayed days fixed?', 'No. They are an indicative proposal adapted to the group.'], ['Is a specific library or agent required?', 'No. Choices stay proportional to the team context.']] } : es ? { pedagogy: ['Demostraciones breves, práctica guiada y revisión colectiva', 'Ejemplos cercanos al negocio sin bibliotecas innecesarias', 'Proyecto transversal dividido en entregas verificables'], evaluation: ['Evaluación inicial', 'Revisión de prácticas con criterios claros', 'Evaluación final: explicar, corregir y entregar una parte testeada'], materials: ['Node.js LTS, editor, navegador y Git', 'Acceso al repositorio y entorno aislado'], deliverables: ['Repositorio y ejercicios realizados', 'Checklist práctica y siguientes pasos'], adaptation: 'El dominio, ritmo, nivel y herramientas se adaptan durante el encuadre.', faq: [['¿Los días indicados son fijos?', 'No. Son una propuesta orientativa adaptada al grupo.'], ['¿Se exige una biblioteca o un agente?', 'No. Las decisiones se ajustan al contexto.']] } : { pedagogy: ['Démonstrations courtes, pratique guidée et corrections collectives', 'Exemples métier sans accumulation de bibliothèques', 'Projet fil rouge découpé en tranches vérifiables'], evaluation: ['Positionnement initial', 'Revue des TP avec critères explicites', 'Évaluation finale : expliquer, corriger et livrer une tranche testée'], materials: ['Node.js LTS, éditeur, navigateur et Git', 'Accès au dépôt et environnement isolé'], deliverables: ['Dépôt et exercices réalisés', 'Checklist pratique et prochaines étapes'], adaptation: 'Le domaine, le rythme, le niveau et les outils sont adaptés après cadrage.', faq: [['Les jours affichés sont-ils fixes ?', 'Non. Il s’agit d’une proposition indicative adaptée au groupe.'], ['Une bibliothèque ou un agent précis est-il imposé ?', 'Non. Les choix restent proportionnés au contexte.']] };
  return { slug, ...copy, ...generic, cta: en ? `Request the ${copy.title} programme` : es ? `Solicitar el programa de ${copy.title}` : `Demander le programme ${copy.title}` };
};

const locale = (Astro.currentLocale ?? defaultLocale) as Locale; const t = labels[locale]; const slug = Astro.props.trainingSlug as string | undefined; const slugs = ['react-typescript', 'node-backend', 'ia-developpeurs']; const current = slug ? build(locale, slug) : null; const title = current?.title ?? t.catalogue; const description = current?.description ?? (locale === 'fr' ? 'Des programmes concrets pour développeurs et équipes.' : locale === 'es' ? 'Programas prácticos para desarrolladores y equipos.' : 'Practical programmes for developers and teams.'); const jsonLd = current ? [{ '@context': 'https://schema.org', '@type': 'Course', name: current.title, description: current.description, provider: { '@type': 'Person', name: 'Christophe Crognier', url: 'https://fullstackchris.dev/about/' }, timeRequired: current.duration }, { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: t.home, item: `https://fullstackchris.dev${home(locale)}` }, { '@type': 'ListItem', position: 2, name: t.catalogue, item: `https://fullstackchris.dev${path(locale)}` }, { '@type': 'ListItem', position: 3, name: current.title, item: `https://fullstackchris.dev${path(locale, slug)}` }] }] : undefined; const section = 'mx-auto w-full max-w-site px-6 py-14 sm:px-8 lg:px-10';
---
<PageLayout title={`${title} — Christophe Crognier`} description={description} canonical={`https://fullstackchris.dev${path(locale, slug)}`} availableLocales={locales} jsonLd={jsonLd}><section class="site-hero hero-glow-field glow-bg grid-bg relative overflow-hidden border-b border-border"><div class={section}><nav class="mb-6 font-mono text-xs text-low"><a href={home(locale)}>{t.home}</a><span class="mx-2">/</span><a href={path(locale)}>{t.catalogue}</a>{current && <><span class="mx-2">/</span><span class="text-secondary">{current.title}</span></>}</nav><p class="font-mono text-xs uppercase tracking-[0.18em] text-accent">{t.course}</p><h1 class="mt-4 max-w-4xl font-display text-[clamp(2.2rem,5vw,4.2rem)] font-bold leading-[1.02] text-white">{current?.title ?? t.hero}</h1><p class="mt-6 max-w-3xl text-[clamp(1rem,1.6vw,1.2rem)] leading-8 text-secondary">{description}</p><Button href={contact(locale)} variant="primary" size="lg" class="mt-8">{current?.cta ?? t.request} →</Button><TrainingLegalNotice locale={locale} compact /></div></section>{!current ? <><section class={section}><div class="grid gap-5 md:grid-cols-3">{slugs.map((item) => { const c = build(locale, item); return <Card hover class="flex flex-col gap-4"><span class="font-mono text-xs uppercase tracking-widest text-accent">{t.course}</span><h2 class="font-display text-xl font-semibold text-white">{c.title}</h2><p class="text-sm leading-6 text-secondary">{c.description}</p><p class="text-xs text-low">{c.duration}</p><Button href={path(locale, item)} variant="secondary" size="sm" class="mt-4 w-fit self-start">{t.programme} →</Button></Card>; })}</div></section><section class="border-y border-border bg-surface/40"><div class={`${section} grid gap-8 md:grid-cols-[1fr_auto] md:items-center`}><div><p class="font-mono text-xs uppercase tracking-widest text-accent">Human Coders</p><h2 class="mt-3 font-display text-3xl font-semibold text-white">{t.human}</h2><p class="mt-4 max-w-2xl leading-7 text-secondary">{t.humanText}</p></div><div class="hc-logo-card"><Image src={humanCodersLogo} alt="Human Coders" width={190} height={52} loading="lazy" decoding="async" /><a href="https://www-eu.humancoders.com/formateurs/christophe-crognier" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex text-sm text-accent">{t.humanLink} ↗</a></div></div></section></> : <section class={section}><div class="mb-10 rounded-xl border border-accent/30 bg-accent-soft p-7"><h2 class="font-display text-2xl font-semibold text-white">{t.business}</h2><p class="mt-3 max-w-4xl leading-7 text-secondary">{locale === 'fr' ? 'Les participants repartent avec une méthode et un livrable testable, reliés aux contraintes d’un projet réel.' : locale === 'es' ? 'Los participantes trabajan con un entregable realista y se llevan métodos réutilisables.' : 'Participants work on a realistic deliverable and leave with reusable methods.'}</p><p class="mt-3 text-sm text-accent">{current.duration} · {t.duration}</p></div><div class="grid gap-6 lg:grid-cols-2">{([[t.audience, current.audience], [t.prerequisites, current.prerequisites], [t.goals, current.goals], [t.skills, current.skills], [t.pedagogy, current.pedagogy], [t.evaluation, current.evaluation], [t.materials, current.materials], [t.deliverables, current.deliverables]] as [string, string[]][]).map(([h, items]) => <Card><h2 class="font-display text-xl font-semibold text-white">{h}</h2><ul class="mt-5 space-y-3">{items.map((item) => <li class="flex gap-3 text-secondary"><span class="text-accent">→</span><span>{item}</span></li>)}</ul></Card>)}</div><section class="mt-12"><h2 class="font-display text-3xl font-semibold text-white">{t.programme}</h2><div class="mt-6 space-y-5">{current.days.map((day) => <Card><h3 class="font-display text-xl font-semibold text-white">{day.title}</h3><ul class="mt-4 space-y-2">{day.modules.map((module) => <li class="text-secondary">• {module}</li>)}</ul><p class="mt-4 rounded-lg border border-border bg-surface/50 p-4 text-sm text-accent"><strong>{t.practice}:</strong> {day.practice}</p></Card>)}</div></section><section class="mt-12"><h2 class="font-display text-3xl font-semibold text-white">{t.adaptation}</h2><p class="mt-4 max-w-4xl leading-7 text-secondary">{current.adaptation}</p></section><section class="mt-12"><h2 class="font-display text-3xl font-semibold text-white">{t.faq}</h2><div class="mt-6 grid gap-4 md:grid-cols-2">{current.faq.map(([q, a]) => <Card><h3 class="font-display font-semibold text-white">{q}</h3><p class="mt-3 leading-7 text-secondary">{a}</p></Card>)}</div></section><div class="mt-12 rounded-xl border border-accent/40 bg-accent-soft p-8"><h2 class="font-display text-2xl font-semibold text-white">{t.request}</h2><p class="mt-3 max-w-3xl leading-7 text-secondary">{t.duration}</p><Button href={contact(locale)} variant="primary" size="lg" class="mt-6">{current.cta} →</Button></div><TrainingLegalNotice locale={locale} /></section>}</PageLayout>
<style is:inline>.hc-logo-card{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:1.25rem 1.5rem;border:1px solid var(--border-strong);border-radius:var(--r-md);background:rgba(255,255,255,.08);min-width:220px}.hc-logo-card img{width:190px;height:auto;object-fit:contain}</style>
