---
import PageLayout from '../components/layout/PageLayout.astro';
import HeroV2 from '../components/hero/HeroV2.astro';
import {
  heroStats, workModes, buildStats, serviceOffers, processSteps,
  pricingPlans, newsletterIssue, feedbackCards, faqs, BOOK_CALL_URL,
  SITE_ALIASES, SOCIAL_LINKS,
} from '../config/constants';
import { technologyCategories } from '../config/constants';
import TechStackGrouped from '../components/ui/TechStackGrouped.astro';
import { Button } from '../components/ui/Button';
import { Card } from '../components/ui/Card';
import { SectionHeader } from '../components/ui/SectionHeader';
import { ServiceCard } from '../components/ui/ServiceCard';
import { PricingCard } from '../components/ui/PricingCard';
import ProjectsModal from '../components/islands/ProjectsModal';
import FAQAccordion from '../components/islands/FAQAccordion';
import NewsletterForm from '../components/islands/NewsletterForm';
import NewsletterPreview from '../components/islands/NewsletterPreview';
import ProcessStepper from '../components/islands/ProcessStepper';

const sectionClass = "mx-auto w-full max-w-site px-6 py-20 sm:px-8 lg:px-10";

const serviceCtaMap: Record<string, string> = {
  "AI Web Dev Newsletter": "/services/ai-web-development-newsletter",
  "Web Project Coaching": "/services/web-project-coaching",
  "Full-stack Development Day": "/services/full-stack-development-day",
  "AI Clarity Bootstrap Workshop": "/services/mvp-bootstrapping-workshop",
  "Custom MVP Development": "/services/mvp-development",
};

// Maps the Home pricing plan titles to their dedicated service page so
// the CTA opens the full landing page (with details + stripe link) instead
// of jumping straight to the booking page.
const pricingPlanServiceMap: Record<string, string> = {
  "Coaching Session": "/services/web-project-coaching",
  "Development Day": "/services/full-stack-development-day",
  "MVP Workshop": "/services/mvp-bootstrapping-workshop",
};

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Christophe Crognier",
    alternateName: SITE_ALIASES,
    url: "https://fullstackchris.dev",
    jobTitle: "Full-Stack Developer",
    sameAs: [
      SOCIAL_LINKS.linkedin,
      SOCIAL_LINKS.github,
      SOCIAL_LINKS.twitter,
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Full Stack Chris",
    alternateName: ["fullstackchris.dev", ...SITE_ALIASES],
    url: "https://fullstackchris.dev",
    description: "Full-stack development, coaching, and MVP services for founders and developers.",
  },
];
---

<PageLayout
  title="Full-Stack Web Development, AI Workflows and Technical Coaching — fullstackchris.dev"
  description="I help founders, freelancers and small teams clarify, build and launch web projects using React, Node.js, TypeScript and practical AI-assisted development workflows — full-stack development, web project coaching, MVP roadmap and custom MVP development."
  jsonLd={jsonLd}
>
  <!-- Hero V2 — Cursor AI build board -->
  <HeroV2 />

  <!-- Why work with me -->
  <section class="border-y border-border bg-surface/40">
    <div class={sectionClass}>
      <SectionHeader eyebrow="WHY WORK WITH ME" title="Developer execution, teaching clarity, AI without the bullshit." data-reveal="fade" />
      <div class="mt-10 grid gap-0 md:grid-cols-3" data-stagger="90" data-stagger-base="80">
        <div class="py-8 pr-8" data-reveal="soft-left">
          <div class="mb-4 grid h-10 w-10 place-items-center rounded-lg border border-accent bg-accent-soft text-accent">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
          </div>
          <h4 class="mb-2 font-display text-[1.1rem] font-semibold text-white">I can explain it</h4>
          <p class="text-[0.95rem] leading-7 text-secondary">~7,000 hours teaching web development means I cut through jargon and help non-technical founders make confident decisions.</p>
        </div>
        <div class="py-8 pr-8" data-reveal="zoom">
          <div class="mb-4 grid h-10 w-10 place-items-center rounded-lg border border-accent bg-accent-soft text-accent">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m8 3 4 8 5-5 5 15H2L8 3z"/></svg>
          </div>
          <h4 class="mb-2 font-display text-[1.1rem] font-semibold text-white">I can scope it</h4>
          <p class="text-[0.95rem] leading-7 text-secondary">I turn a vague idea into a prioritized MVP and a realistic budget — so you don't burn weeks building the wrong thing.</p>
        </div>
        <div class="py-8 pr-8" data-reveal="soft-right">
          <div class="mb-4 grid h-10 w-10 place-items-center rounded-lg border border-accent bg-accent-soft text-accent">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <h4 class="mb-2 font-display text-[1.1rem] font-semibold text-white">I can build it</h4>
          <p class="text-[0.95rem] leading-7 text-secondary">React, Next.js, Node, TypeScript and Postgres — shipped to production, with AI-assisted workflows where they genuinely help.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class={sectionClass} id="services">
    <SectionHeader eyebrow="WHAT I OFFER" title="One ladder, from first call to launched product." description="Start wherever you are. Each service hands off cleanly to the next — clarity, then focused build, then a full MVP." data-reveal="fade" />
    <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3" data-stagger="85" data-stagger-base="80">
      {serviceOffers.map((offer) => (
        <div class="h-full" data-reveal={offer.featured ? 'zoom' : 'blur'}>
          <ServiceCard
            title={offer.title}
            description={offer.description}
            price={offer.price}
            priceUnit={offer.priceUnit}
            badge={offer.badge}
            featured={offer.featured}
            ctaHref={serviceCtaMap[offer.title] ?? '/services'}
            ctaLabel={offer.badge === 'Newsletter' ? 'Subscribe →' : 'Learn more →'}
            ctaVariant={offer.featured ? 'primary' : 'outline'}
          />
        </div>
      ))}
      <Card hover class="breathing-violet-glow flex h-full min-h-[260px] flex-col gap-7 border-accent/25 bg-gradient-to-b from-accent/8 to-transparent p-8" data-reveal="zoom">
        <div class="grid h-10 w-10 place-items-center rounded-lg border border-accent bg-accent-soft text-accent">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2v20M2 12h20"/></svg>
        </div>
        <div class="space-y-4">
          <h3 class="font-display text-xl font-semibold text-white">Not sure where to start?</h3>
          <p class="text-[0.95rem] leading-7 text-secondary">Book a free 30-minute call. I'll help you figure out the right next step for your project.</p>
        </div>
        <div class="mt-2 flex flex-wrap items-center justify-end gap-4 border-t border-border pt-5">
          <Button href="/contact" variant="secondary" size="sm">
            Ask a question
          </Button>
          <Button href={BOOK_CALL_URL} variant="primary" size="sm">
            Book a call →
          </Button>
        </div>
      </Card>
    </div>
  </section>

  <!-- How we work — process explained right after the offer -->
  <section class="border-y border-border bg-surface/40" id="process">
    <div class={sectionClass}>
      <SectionHeader eyebrow="Process" title="How a session works." description="From first call to shipped code — the same delivery flow on every engagement." data-reveal="fade" />
      <div data-reveal="soft-right">
        <ProcessStepper steps={processSteps} client:visible />
      </div>
    </div>
  </section>

  <!-- Projects — proof of execution -->
  <section class={sectionClass} id="projects">
    <SectionHeader eyebrow="Recent work" title="AI-assisted web projects shipped end-to-end." description="Real React, Node.js and TypeScript products — desktop apps, web tools and games. Click any project to read the full case study." data-reveal="fade" />
    <div data-reveal="zoom">
      <ProjectsModal client:load />
    </div>
  </section>

  <!-- Testimonials — social proof right after projects -->
  <section class="border-y border-border bg-surface/40">
    <div class={sectionClass}>
      <SectionHeader eyebrow="Real feedback" title="What founders and developers say." data-reveal="fade" />
      <div class="mt-10 grid gap-5 md:grid-cols-3" data-stagger="100" data-stagger-base="80">
        {feedbackCards.map((fb) => (
          <Card class="flex flex-col gap-4" data-reveal="blur">
            <p class="text-[0.95rem] leading-7 text-secondary italic">"{fb.testimonial}"</p>
            <div class="mt-auto border-t border-border pt-4">
              <p class="font-display text-sm font-semibold text-white">{fb.name}</p>
              <p class="text-xs text-low">{fb.designation} · {fb.company}</p>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Tech stack — credibility builder before pricing -->
  <section id="tech-stack" class={sectionClass}>
    <SectionHeader eyebrow="Tech stack" title="React, Node.js, TypeScript and AI tools used daily." data-reveal="fade" />
    <div class="mt-8">
      <TechStackGrouped categories={technologyCategories} />
    </div>
  </section>

  <!-- Pricing -->
  <section class="border-y border-border bg-surface/40">
    <div class={sectionClass}>
      <SectionHeader eyebrow="Pricing" title="Pick your plan." description="All sessions include clear deliverables. Book a call if you need a custom quote." data-reveal="fade" />
      <div class="mt-10 grid gap-5 md:grid-cols-3" data-stagger="100" data-stagger-base="80">
        {pricingPlans.map((plan) => {
          const servicePage = pricingPlanServiceMap[plan.title];
          return (
            <div class="h-full" data-reveal={plan.featured ? 'zoom' : 'soft-left'}>
              <PricingCard
                title={plan.title}
                description={plan.description}
                price={plan.price}
                period={plan.period}
                features={plan.features}
                ctaLabel={servicePage ? 'See plans →' : 'Book a call'}
                ctaHref={servicePage ?? BOOK_CALL_URL}
                featured={plan.featured}
              />
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="border-y border-border bg-surface/40" id="newsletter">
    <div class={sectionClass}>
      <div class="newsletter-outer-glow" data-reveal="zoom">
        <Card class="border-accent/45 bg-gradient-to-br from-raised via-tertiary to-surface-deep p-8 sm:p-10 lg:p-14">
          <div class="grid gap-10 lg:grid-cols-[1.08fr_0.92fr] lg:items-center">
            <div class="max-w-2xl">
              <p class="mb-5 inline-flex items-center gap-3 font-mono text-xs font-semibold uppercase tracking-[0.22em] text-accent">
                <span class="h-px w-5 bg-accent" aria-hidden="true"></span>
                Free + Paid
              </p>
              <h2 class="max-w-xl font-display text-[clamp(2rem,4vw,3rem)] font-semibold leading-[1.05] text-white">
                Stay ahead of AI web dev without the noise.
              </h2>
              <p class="mt-5 max-w-xl text-[1.05rem] leading-8 text-secondary">
                A practical monthly briefing for builders. What's worth testing, what to ignore, and the prompts and workflows I actually use.
              </p>
              <div class="mt-8">
                <NewsletterForm client:visible />
              </div>
              <p class="mt-4 text-sm leading-6 text-low">
                Free sample available · Solo €9/mo · Pro €19/mo · cancel anytime
              </p>
            </div>
            <div class="overflow-hidden rounded-xl border border-border bg-primary/80 font-mono text-sm text-secondary shadow-lg shadow-black/30">
              <div class="flex items-center gap-3 border-b border-border bg-raised/60 px-5 py-4">
                <span class="flex gap-2" aria-hidden="true">
                  <span class="h-3 w-3 rounded-full bg-white/10"></span>
                  <span class="h-3 w-3 rounded-full bg-white/10"></span>
                  <span class="h-3 w-3 rounded-full bg-white/10"></span>
                </span>
                <span class="text-low">june-issue.md</span>
              </div>
              <NewsletterPreview items={newsletterIssue} client:visible />
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class={sectionClass}>
    <div class="grid gap-12 lg:grid-cols-[1fr_1.5fr]">
      <SectionHeader eyebrow="Questions" title="Common questions answered." description="Still not sure? Book a free 30-minute call." data-reveal="soft-left" />
      <div data-reveal="soft-right">
        <FAQAccordion client:visible />
      </div>
    </div>
  </section>

  <!-- Book a call CTA -->
  <section class="glow-bg grid-bg relative overflow-hidden border-b border-border" id="contact">
    <div class={sectionClass}>
      <div class="flex flex-col items-center gap-6 py-10 text-center" data-reveal="zoom">
        <span class="font-mono text-xs uppercase tracking-widest text-accent">START HERE</span>
        <h2 class="max-w-2xl font-display text-[clamp(2rem,4.5vw,3.5rem)] font-semibold leading-tight text-white">
          Bring me your idea, blocker or product goal.
        </h2>
        <p class="max-w-prose text-lg leading-8 text-secondary">
          I'll help you clarify it, understand it, build it and launch it. Start with a call — I'll find the right next step with you.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <Button href={BOOK_CALL_URL} variant="primary" size="lg">
            Book a project call <span class="ml-1">→</span>
          </Button>
          <Button href="/services" variant="secondary" size="lg">
            See all services
          </Button>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
