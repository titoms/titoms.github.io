---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../components/layout/PageLayout.astro';
import { Badge } from '../../components/ui/Badge';
import { Button } from '../../components/ui/Button';
import { Card } from '../../components/ui/Card';
import { SectionHeader } from '../../components/ui/SectionHeader';

export async function getStaticPaths() {
  const articles = await getCollection('blog');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const sectionClass = "mx-auto w-full max-w-site px-6 py-20 sm:px-8 lg:px-10";
const articleUrl = `https://fullstackchris.dev/blog/${article.id}`;
const pageTitle = article.data.metaTitle ?? article.data.title;

const formatDate = new Intl.DateTimeFormat('en', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const relatedServices = [
  {
    slug: "web-project-coaching",
    title: "Web project coaching",
    description: "Get hands-on guidance on your project or blocker.",
  },
  {
    slug: "full-stack-development-day",
    title: "Development day",
    description: "Book a focused development session.",
  },
  {
    slug: "mvp-bootstrapping-workshop",
    title: "MVP workshop",
    description: "Turn your idea into a realistic build plan.",
  },
];

const jsonLd: object[] = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: article.data.title,
    description: article.data.description,
    author: {
      "@type": "Person",
      name: "Christophe Crognier",
      url: "https://fullstackchris.dev",
    },
    datePublished: article.data.publishedAt.toISOString(),
    dateModified: (article.data.updatedAt ?? article.data.publishedAt).toISOString(),
    url: articleUrl,
    mainEntityOfPage: articleUrl,
    keywords: article.data.tags.join(", "),
    isPartOf: {
      "@type": "Blog",
      name: "fullstackchris.dev Blog",
      url: "https://fullstackchris.dev/blog",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Blog", item: "https://fullstackchris.dev/blog" },
      { "@type": "ListItem", position: 2, name: article.data.title, item: articleUrl },
    ],
  },
];

if (article.data.faqs.length > 0) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: article.data.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  });
}
---

<PageLayout
  title={`${pageTitle} - fullstackchris.dev`}
  description={article.data.description}
  canonical={articleUrl}
  ogType="article"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="site-hero hero-glow-field glow-bg grid-bg relative overflow-hidden border-b border-border mb-4">
    <div class={`${sectionClass} site-hero-inner`}>
      <div class="flex flex-wrap gap-2">
        {article.data.tags.map((tag: string) => (
          <Badge variant="default">{tag}</Badge>
        ))}
        {article.data.comingSoon && <Badge variant="accent">Coming soon</Badge>}
      </div>
      <p class="mt-5 font-mono text-xs uppercase tracking-[0.16em] text-low">
        {formatDate.format(article.data.publishedAt)}
      </p>
      <h1 class="mt-6 max-w-4xl font-display text-[clamp(2.2rem,5vw,4.2rem)] font-bold leading-[1.02] tracking-normal text-white">
        {article.data.title}
      </h1>
      <p class="mt-6 max-w-prose text-[clamp(1rem,1.6vw,1.2rem)] leading-8 text-secondary">
        {article.data.description}
      </p>
      <Button href="/blog" variant="secondary" size="sm" class="mt-8" aria-label="Back to all articles">
        <span aria-hidden="true">&larr;</span> All articles
      </Button>
    </div>
  </section>

  <!-- Coming soon state -->
  {article.data.comingSoon && (
    <section class={sectionClass}>
      <Card class="mx-auto max-w-3xl p-10 sm:p-14">
        <div class="flex flex-col items-center gap-6 py-10 text-center">
          <Badge variant="accent">Coming soon</Badge>
          <h2 class="font-display text-2xl font-semibold text-white">
            This article is in progress.
          </h2>
          <p class="max-w-prose text-secondary">
            I am working on this article. Subscribe to the AI web development newsletter to get notified when it publishes.
          </p>
          <div class="flex flex-col gap-3 sm:flex-row">
            <Button href="/services/ai-web-development-newsletter" variant="primary" size="lg">
              Join the newsletter
            </Button>
            <Button href="/blog" variant="secondary" size="lg">
              Back to blog
            </Button>
          </div>
        </div>
      </Card>
    </section>
  )}

  <!-- Article content -->
  {!article.data.comingSoon && (
    <section class={sectionClass}>
      {article.data.imagePrompt && (
        <div class="mx-auto mb-10 max-w-3xl rounded-lg border border-dashed border-accent/50 bg-accent-soft p-5">
          <p class="font-mono text-xs uppercase tracking-[0.16em] text-accent">Image placeholder</p>
          <p class="mt-3 text-sm leading-7 text-secondary">{article.data.imagePrompt}</p>
        </div>
      )}
      <div class="article-content mx-auto max-w-3xl">
        <Content />
      </div>
    </section>
  )}

  <!-- Related services -->
  <section class="border-t border-border bg-surface/55">
    <div class={sectionClass}>
      <SectionHeader eyebrow="Next step" title="Work with me directly." />
      <div class="mt-10 grid gap-4 sm:grid-cols-3">
        {relatedServices.map((service) => (
          <Card hover class="flex flex-col gap-3">
            <h3 class="font-display text-lg font-semibold text-white">{service.title}</h3>
            <p class="text-sm leading-6 text-secondary">{service.description}</p>
            <Button href={`/services/${service.slug}`} variant="secondary" size="sm" class="mt-auto w-fit">
              Learn more
            </Button>
          </Card>
        ))}
      </div>
    </div>
  </section>
</PageLayout>
