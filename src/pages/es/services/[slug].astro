---
import ServiceDetailView from '../../../components/pages/ServiceDetailView.astro';
import { getServicePages } from '../../../config/services';

export async function getStaticPaths() {
  return getServicePages('es').map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---
<ServiceDetailView service={service} />
