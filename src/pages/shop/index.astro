---
import CommerceLayout from '../../components/layout/CommerceLayout.astro';
import ProductGrid from '../../components/islands/shop/ProductGrid';
import { PRODUCTS, PRODUCT_CATEGORIES, categoryToSlug, formatPrice } from '../../config/products';
import { SITE_FEATURES } from '../../config/constants';

const featured = PRODUCTS.find((p) => p.id === 'ds-violet')!;
const categoryCounts = PRODUCT_CATEGORIES.map((cat) => ({
  cat,
  slug: categoryToSlug(cat),
  count: PRODUCTS.filter((p) => p.category === cat).length,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Shop — fullstackchris.dev',
  description: 'Templates, design systems and free resources for web builders.',
};
---

<CommerceLayout
  title="Shop — Templates, Design Systems & Free Resources"
  description="Astro/React/Tailwind templates, design systems and free starter kits. Instant download, secure Stripe checkout."
  noindex={!SITE_FEATURES.shopBooking}
  jsonLd={jsonLd}
  showCart
>
  <section class="shop-hero glow-bg grid-bg">
    <div class="container">
      <span class="eyebrow">Shop</span>
      <h1 class="t-h1" style="margin: var(--sp-4) 0; max-width: 20ch;">Templates, design systems and free resources — built to ship, not just look nice.</h1>
      <p class="t-lead" style="max-width: 56ch;">Everything I use myself: Astro/React/Tailwind templates, the exact design system behind this site, and free starter kits. Instant download, no subscriptions.</p>
    </div>
  </section>

  <div class="container">
    <div class="trust-bar">
      <div class="t-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Secure checkout via Stripe</div>
      <div class="t-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>Instant digital download</div>
      <div class="t-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="20 6 9 17 4 12"/></svg>Built from real client work</div>
      <div class="t-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s8-4.5 8-11V5l-8-3-8 3v6c0 6.5 8 11 8 11Z"/></svg>14-day money-back guarantee</div>
    </div>

    <a href={`/shop/product/${featured.slug}/`} class="featured-banner">
      <span class="eyebrow no-rule">Bestseller</span>
      <h2 class="t-h2" style="margin: 14px 0 12px;">{featured.title}</h2>
      <p class="t-body" style="max-width: 48ch;">{featured.description}</p>
      <div class="row gap-4" style="margin-top: var(--sp-5);">
        <span class="pdp-price-row" style="margin: 0;">
          <span class="amt" style="font-size: 1.5rem;">{formatPrice(featured.priceCents)}</span>
          {featured.compareAtPriceCents && <span class="was">{formatPrice(featured.compareAtPriceCents)}</span>}
        </span>
        <span class="btn btn-primary btn-sm">View product <span class="arrow">→</span></span>
      </div>
    </a>

    <div class="cat-rail">
      {categoryCounts.map(({ cat, slug, count }) => (
        <a href={`/shop/category/${slug}/`} class="card card-hover cat-tile">
          <span class="eyebrow no-rule" style="font-size: 0.68rem;">{count} item{count === 1 ? '' : 's'}</span>
          <h3 class="t-h4">{cat}</h3>
          <span class="t-small">Browse <span class="arrow">→</span></span>
        </a>
      ))}
    </div>

    <section class="section" style="padding-top: 0;">
      <ProductGrid client:only="react" />
    </section>
  </div>
</CommerceLayout>
