---
import CommerceLayout from '../../../components/layout/CommerceLayout.astro';
import { PRODUCTS, formatPrice } from '../../../config/products';
import { SITE_FEATURES } from '../../../config/constants';
import PurchasePanel from '../../../components/islands/shop/PurchasePanel';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

const related = PRODUCTS.filter((p) => p.category === product.category && p.id !== product.id).slice(0, 3);
const initials = product.title.split(' ').map((w) => w[0]).join('').slice(0, 2);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.title,
  description: product.description,
  category: product.category,
  offers: {
    '@type': 'Offer',
    price: (product.priceCents / 100).toFixed(2),
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
  },
};
---

<CommerceLayout
  title={`${product.title} — Shop`}
  description={product.tagline}
  noindex={!SITE_FEATURES.shopBooking}
  jsonLd={jsonLd}
  showCart
>
  <div class="container shop-crumb">
    <div class="breadcrumb">
      <a href="/shop/">Shop</a><span class="sep">/</span>
      <a href={`/shop/category/${product.category.toLowerCase()}/`}>{product.category}</a><span class="sep">/</span>
      <span>{product.title}</span>
    </div>
  </div>

  <section class="section" style="padding-top: var(--sp-6);">
    <div class="container">
      <div class="pdp-grid">
        <div class="pdp-gallery">
          <div class="main-shot card" style="padding: 0;">
            <span class="ph" style="position:absolute; inset:0; font-size: 1rem;">{initials} · Preview</span>
          </div>
          <div class="pdp-thumbs">
            {[0, 1, 2].map((i) => (
              <button type="button" class={`th${i === 0 ? ' active' : ''}`} style="position: relative;" aria-label={`Screenshot ${i + 1}`}>
                <span class="ph" style="position:absolute; inset:0;">{i + 1}</span>
              </button>
            ))}
          </div>

          <div style="margin-top: var(--sp-7);">
            <h2 class="t-h3" style="margin-bottom: var(--sp-4);">What's included</h2>
            <ul class="included-list">
              {product.whatsIncluded.map((item) => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <div style="margin-top: var(--sp-7);">
            <h2 class="t-h3" style="margin-bottom: var(--sp-4);">Details</h2>
            <div class="tech-grid">
              {product.techSpecs.map(({ label, value }) => (
                <div class="tech-row"><span class="k">{label}</span><span class="v">{value}</span></div>
              ))}
              <div class="tech-row"><span class="k">License</span><span class="v">{product.license}</span></div>
            </div>
          </div>
        </div>

        <div class="pdp-info">
          <span class="cat">{product.category}</span>
          <h1>{product.title}</h1>
          <p class="t-body">{product.description}</p>

          <div class="pdp-price-row">
            <span class={product.priceCents === 0 ? 'price-free' : 'amt'}>{formatPrice(product.priceCents)}</span>
            {product.compareAtPriceCents && <span class="was">{formatPrice(product.compareAtPriceCents)}</span>}
          </div>

          <PurchasePanel client:only="react" productId={product.id} />

          <div class="pdp-trust">
            <span class="t-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>Instant download</span>
            <span class="t-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Secure Stripe payment</span>
            <span class="t-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4.5 8-11V5l-8-3-8 3v6c0 6.5 8 11 8 11Z"/></svg>14-day money back</span>
          </div>
        </div>
      </div>

      {product.goodFit.length > 0 && (
        <section class="section">
          <h2 class="t-h2" style="margin-bottom: var(--sp-6);">Good fit / not a fit</h2>
          <div class="fit-cols">
            <div class="card fit-card good">
              <h4 class="t-h4"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--positive)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>This is for you if…</h4>
              <ul class="fit-list good">
                {product.goodFit.map((item) => (
                  <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>{item}</li>
                ))}
              </ul>
            </div>
            <div class="card fit-card bad">
              <h4 class="t-h4"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--negative)" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>Skip it if…</h4>
              <ul class="fit-list bad">
                {product.notFit.map((item) => (
                  <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      )}

      {product.faqs.length > 0 && (
        <section class="section">
          <h2 class="t-h2" style="margin-bottom: var(--sp-6);">Questions</h2>
          <div>
            {product.faqs.map(({ q, a }) => (
              <div class="faq-item">
                <button type="button" class="faq-q">{q}<span class="chev">▾</span></button>
                <div class="faq-a"><p>{a}</p></div>
              </div>
            ))}
          </div>
        </section>
      )}

      {related.length > 0 && (
        <section class="section">
          <h2 class="t-h2" style="margin-bottom: var(--sp-6);">Related products</h2>
          <div class="pgrid">
            {related.map((rel) => (
              <article class="card card-hover pcard">
                <a class="thumb" href={`/shop/product/${rel.slug}/`}><span class="ph">{rel.title}</span></a>
                <div class="body">
                  <span class="cat">{rel.category}</span>
                  <h4><a href={`/shop/product/${rel.slug}/`} style="color: inherit; text-decoration: none;">{rel.title}</a></h4>
                  <div class="foot">
                    <span class={rel.priceCents === 0 ? 'price-free' : 'price-now'}>{formatPrice(rel.priceCents)}</span>
                    <a href={`/shop/product/${rel.slug}/`} class="btn btn-secondary btn-sm">View <span class="arrow">→</span></a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}
    </div>
  </section>
</CommerceLayout>

<script>
  document.querySelectorAll<HTMLElement>('.faq-q').forEach((q) => {
    q.addEventListener('click', () => q.parentElement?.classList.toggle('open'));
  });
</script>
