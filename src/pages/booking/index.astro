---
import CommerceLayout from '../../components/layout/CommerceLayout.astro';
import CustomQuoteForm from '../../components/islands/booking/CustomQuoteForm';
import { BOOKING_SERVICES } from '../../config/bookingServices';
import { SITE_FEATURES } from '../../config/constants';

const bookable = BOOKING_SERVICES.filter((s) => s.priceCents !== null);
const custom = BOOKING_SERVICES.find((s) => s.priceCents === null)!;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Coaching and development sessions',
  itemListElement: bookable.map((s) => ({
    '@type': 'Offer',
    name: s.title,
    price: (s.priceCents! / 100).toFixed(2),
    priceCurrency: 'EUR',
  })),
};
---

<CommerceLayout
  title="Book a Session — Coaching, Development & Workshops"
  description="Book a paid coaching session, development day or MVP workshop. Pick a slot from the live calendar, pay securely, get a calendar invite."
  noindex={!SITE_FEATURES.shopBooking}
  jsonLd={jsonLd}
>
  <section class="bk-hero glow-bg grid-bg">
    <div class="container">
      <span class="eyebrow">Booking</span>
      <h1 class="t-h1" style="margin: var(--sp-4) 0; max-width: 22ch;">Book focused time with a senior developer.</h1>
      <p class="t-lead" style="max-width: 56ch;">Pick a service, choose a slot from my live calendar and pay securely. You'll get a video-call link and calendar invite by email within a minute.</p>
    </div>
  </section>

  <div class="container">
    <div class="bk-trust">
      <div class="t-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>Live Google Calendar availability</div>
      <div class="t-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Secure Stripe payment</div>
      <div class="t-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="20 6 9 17 4 12"/></svg>Free reschedule up to 24h before</div>
      <div class="t-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 10l5 3-5 3v-6z"/><rect x="3" y="6" width="18" height="12" rx="2"/></svg>Video call included</div>
    </div>

    <section class="section" style="padding-top: 0;">
      <h2 class="t-h2" style="margin-bottom: var(--sp-6);">Choose a service</h2>
      <div class="grid grid-3">
        {bookable.map((service) => (
          <article class:list={["card", "card-hover", "svc-select", service.featured && "featured"]}>
            <span class="dur-badge">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              {service.durationLabel}
            </span>
            <h3>{service.title}</h3>
            <p class="desc">{service.description}</p>
            <div class="foot">
              <span class="price-tag">€{Math.round(service.priceCents! / 100)}</span>
              <a href={`/booking/schedule/?service=${service.id}`} class="btn btn-primary btn-sm">
                Select <span class="arrow">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section" style="padding-top: 0;">
      <CustomQuoteForm client:only="react" />
    </section>
  </div>
</CommerceLayout>
