---
import PageLayout from '../../components/layout/PageLayout.astro';
import { Badge } from '../../components/ui/Badge';
import { Button } from '../../components/ui/Button';
import { Card } from '../../components/ui/Card';
import { SectionHeader } from '../../components/ui/SectionHeader';
import FAQAccordion from '../../components/islands/FAQAccordion';
import { servicePages } from '../../config/services-data';
import { BOOK_CALL_URL, SITE_ALIASES, SOCIAL_LINKS } from '../../config/constants';
import type { FAQ } from '../../types';

export async function getStaticPaths() {
  return servicePages.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const sectionClass = "mx-auto w-full max-w-site px-6 py-20 sm:px-8 lg:px-10";

const serviceFaqs: FAQ[] = service.faqs.map((f) => ({ question: f.question, answer: f.answer }));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.hero.h1,
  description: service.meta.description,
  provider: {
    "@type": "Person",
    name: "Christophe Crognier",
    alternateName: SITE_ALIASES,
    url: "https://fullstackchris.dev",
    sameAs: [SOCIAL_LINKS.linkedin, SOCIAL_LINKS.github, SOCIAL_LINKS.twitter],
  },
  url: `https://fullstackchris.dev/services/${service.slug}`,
};
---

<PageLayout
  title={`${service.meta.title} — fullstackchris.dev`}
  description={service.meta.description}
  canonical={`https://fullstackchris.dev/services/${service.slug}`}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="site-hero hero-glow-field glow-bg grid-bg relative overflow-hidden border-b border-border mb-12 sm:mb-16">
    <div class="bg-field bv-c" aria-hidden="true">
      <span class="blob blob-1"></span>
      <span class="blob blob-2"></span>
      <span class="blob blob-3"></span>
    </div>
    <div class={`${sectionClass} site-hero-inner`}>
      <nav class="mb-6 flex items-center gap-2 font-mono text-xs text-low reveal r1">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <a href="/services" class="transition-colors hover:text-white">Services</a>
        <span>/</span>
        <span class="text-secondary">{service.badge}</span>
      </nav>
      <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
        <div>
          <span class="font-mono text-xs uppercase tracking-widest text-accent">{service.badge.toUpperCase()}</span>
          <h1 class="reveal r2 mt-4 max-w-4xl font-display text-[clamp(2.2rem,4.5vw,3.8rem)] font-bold leading-[1.05] tracking-normal text-white">
            {service.hero.h1}
          </h1>
          <p class="reveal r3 mt-6 max-w-prose text-[clamp(1rem,1.6vw,1.2rem)] leading-8 text-secondary">
            {service.hero.subtitle}
          </p>
          <div class="reveal r4 mt-8 flex flex-wrap gap-4">
            <Button
              href={service.hero.primaryCtaHref ?? BOOK_CALL_URL}
              variant="primary"
              size="lg"
            >
              {service.hero.primaryCta} →
            </Button>
            {service.hero.secondaryCta && (
              <Button href={service.hero.secondaryCtaHref ?? '#pricing'} variant="secondary" size="lg">
                {service.hero.secondaryCta}
              </Button>
            )}
          </div>
        </div>

        {service.heroCard && (
          <Card class="reveal r5 bg-surface/60">
            {service.heroCard.type === 'chips' && (
              <>
                <span class="font-mono text-xs uppercase tracking-widest text-accent">{service.heroCard.title}</span>
                <div class="mt-4 flex flex-wrap gap-2">
                  {service.heroCard.items?.map((item) => (
                    <Badge variant="default">{item}</Badge>
                  ))}
                </div>
                {service.heroCard.leaveWith && (
                  <>
                    <hr class="my-5 border-border" />
                    <span class="font-mono text-xs uppercase tracking-widest text-accent">LEAVE WITH</span>
                    <p class="mt-3 text-[0.95rem] leading-7 text-secondary">{service.heroCard.leaveWith}</p>
                  </>
                )}
              </>
            )}

            {service.heroCard.type === 'checklist' && (
              <>
                <span class="font-mono text-xs uppercase tracking-widest text-accent">{service.heroCard.title}</span>
                <ul class="mt-4 space-y-2">
                  {service.heroCard.items?.map((item) => (
                    <li class="flex items-center gap-2 text-[0.95rem] text-secondary">
                      <svg class="shrink-0 text-positive" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </>
            )}

            {service.heroCard.type === 'investment' && (
              <>
                <span class="font-mono text-xs uppercase tracking-widest text-accent">{service.heroCard.title}</span>
                <p class="mt-3 font-display text-[2.6rem] font-bold leading-tight tracking-[-0.03em] text-white">{service.heroCard.amount}</p>
                {service.heroCard.note && (
                  <p class="mt-2 text-[0.9rem] leading-6 text-secondary">{service.heroCard.note}</p>
                )}
                {service.heroCard.footer && (
                  <>
                    <hr class="my-4 border-border" />
                    <p class="font-mono text-xs text-low">{service.heroCard.footer}</p>
                  </>
                )}
              </>
            )}
          </Card>
        )}
      </div>
    </div>
  </section>

  {service.answer && (
    <section style="padding-top: 0;">
      <div class="mx-auto max-w-[780px] px-6 py-12 sm:px-8 lg:px-10">
        <blockquote class="border-l-2 border-accent pl-6 font-display text-[1.1rem] leading-8 text-secondary italic" data-reveal="soft-left">
          {service.answer}
        </blockquote>
      </div>
    </section>
  )}

  <!-- Pain points & Outcomes -->
  <section class={sectionClass} style="padding-top: 0;">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <SectionHeader eyebrow="SOUND FAMILIAR?" title="You don't need a full-time hire. You need clarity." data-reveal="fade" />
        <div class="mt-8 grid gap-3 sm:grid-cols-2" data-stagger="70" data-stagger-base="80">
          {service.painPoints.map((point) => (
            <div class="flex items-start gap-3 text-secondary" data-reveal="soft-left">
              <svg class="mt-0.5 shrink-0 text-accent" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
              <p class="text-[0.93rem] leading-6">{point}</p>
            </div>
          ))}
        </div>
      </div>
      <div>
        <SectionHeader eyebrow="WHAT YOU LEAVE WITH" title="Every session ends with a plan." data-reveal="fade" />
        <div class="mt-8 grid gap-3 sm:grid-cols-2" data-stagger="70" data-stagger-base="110">
          {service.outcomes.map((outcome) => (
            <div class="flex items-center gap-3 text-secondary" data-reveal="soft-right">
              <svg class="shrink-0 text-positive" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
              <span class="text-[0.93rem]">{outcome}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {service.useCases && service.useCases.length > 0 && (
    <section class="border-t border-border" style="padding-top: 0;">
      <div class={sectionClass}>
        <SectionHeader eyebrow="WHAT WE CAN WORK ON" title="Use cases." data-reveal="fade" />
        <div class="mt-6 flex flex-wrap gap-2" data-stagger="45" data-stagger-base="60">
          {service.useCases.map((uc) => (
            <Badge variant="default" data-reveal="zoom">{uc}</Badge>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Included -->
  <section class="border-y border-border bg-surface/40">
    <div class={sectionClass}>
      <SectionHeader eyebrow="WHAT'S INCLUDED" title="Every session includes." data-reveal="fade" />
      <div class="mt-10 grid gap-5 sm:grid-cols-2 xl:grid-cols-3" data-stagger="85" data-stagger-base="80">
        {service.included.map((item) => (
          <Card class="flex flex-col gap-2" data-reveal="zoom">
            <h3 class="font-display text-[1.05rem] font-semibold text-white">{item.title}</h3>
            <p class="text-[0.9rem] leading-6 text-secondary">{item.description}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Good fit / Not a fit -->
  {(service.goodFit || service.notAFit) && (
    <section class={sectionClass}>
      <SectionHeader eyebrow="IS IT A FIT?" title="Best results come from clear scope." data-reveal="fade" />
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {service.goodFit && (
          <div class="rounded-lg border border-positive/20 bg-positive/5 p-6" data-reveal="soft-left">
            <h4 class="mb-4 flex items-center gap-2 font-display font-semibold text-white">
              <svg class="text-positive" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 6 9 17l-5-5"/></svg>
              Good fit
            </h4>
            <ul class="space-y-3">
              {service.goodFit.map((item) => (
                <li class="flex items-start gap-3 text-secondary">
                  <svg class="mt-0.5 shrink-0 text-positive" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
                  <span class="text-[0.93rem] leading-6">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {service.notAFit && (
          <div class="rounded-lg border border-accent/20 bg-accent/5 p-6" data-reveal="soft-right">
            <h4 class="mb-4 flex items-center gap-2 font-display font-semibold text-white">
              <svg class="text-accent" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 6 6 18M6 6l12 12"/></svg>
              Not a fit
            </h4>
            <ul class="space-y-3">
              {service.notAFit.map((item) => (
                <li class="flex items-start gap-3 text-secondary">
                  <svg class="mt-0.5 shrink-0 text-accent" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
                  <span class="text-[0.93rem] leading-6">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Pricing -->
  <section class="border-y border-border bg-surface/40" id="pricing">
    <div class={sectionClass}>
      <SectionHeader eyebrow="PRICING" title={service.pricing.length === 1 ? 'Investment.' : 'Three formats.'} data-reveal="fade" />
      <div class="mt-10 mx-auto max-w-[880px]" data-stagger="75" data-stagger-base="80">
        {service.pricing.map((row) => (
          <div class={`flex flex-col gap-3 border-b border-border py-5 last:border-0 sm:flex-row sm:items-center sm:gap-6 ${row.featured ? 'rounded-lg border border-accent/30 bg-accent/5 px-4 py-5 -mx-4' : ''}`} data-reveal="blur">
            {row.featured && <Badge variant="accent">Recommended</Badge>}
            <div class="flex-1">
              <p class="font-display font-medium text-white">{row.label}</p>
            </div>
            <p class="font-display text-[1.5rem] font-bold text-white">{row.price}</p>
            <Button
              href={service.stripeLink && !service.stripeLink.includes('REPLACE') ? service.stripeLink : BOOK_CALL_URL}
              variant={row.featured ? 'primary' : 'secondary'}
              size="sm"
              data-track="stripe_click"
              data-service={service.slug}
            >
              {service.stripeLink && !service.stripeLink.includes('REPLACE') ? 'Buy now' : 'Book'}
            </Button>
          </div>
        ))}
      </div>
      {service.pricingNote && (
        <p class="mt-6 text-sm text-low" data-reveal="fade">{service.pricingNote}</p>
      )}
      <div class="mt-8 flex flex-wrap gap-4" data-reveal="zoom">
        <Button
          href={BOOK_CALL_URL}
          variant="primary"
          size="lg"
          data-track="cta_click"
          data-service={service.slug}
        >
          Book a session
        </Button>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class={sectionClass}>
    <div class="grid gap-12 lg:grid-cols-[1fr_1.5fr]">
      <SectionHeader eyebrow="QUESTIONS" title="Common questions." data-reveal="soft-left" />
      <div data-reveal="soft-right">
        <FAQAccordion faqs={serviceFaqs} client:visible />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="glow-bg grid-bg relative overflow-hidden border-t border-border">
    <div class={sectionClass}>
      <div class="flex flex-col items-center gap-6 py-10 text-center" data-reveal="zoom">
        <h2 class="max-w-xl font-display text-[clamp(1.8rem,3.5vw,2.8rem)] font-semibold leading-tight text-white">
          Ready to get started?
        </h2>
        <div class="flex flex-wrap justify-center gap-4">
          {service.stripeLink && !service.stripeLink.includes('REPLACE') && (
            <Button
              href={service.stripeLink}
              variant="primary"
              size="lg"
              target="_blank"
              rel="noopener noreferrer"
              data-track="stripe_click"
              data-service={service.slug}
            >
              Buy now
            </Button>
          )}
          <Button
            href={BOOK_CALL_URL}
            variant={service.stripeLink && !service.stripeLink.includes('REPLACE') ? "secondary" : "primary"}
            size="lg"
            data-track="cta_click"
            data-service={service.slug}
          >
            {service.hero.primaryCta}
          </Button>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<script is:inline>
  document.querySelectorAll('[data-track]').forEach(function(el) {
    el.addEventListener('click', function() {
      var name = el.dataset.track || 'click';
      var service = el.dataset.service || '';
      if (window.__cfBeacon) window.__cfBeacon.push({ type: 'event', name: name, service: service });
    });
  });
</script>
