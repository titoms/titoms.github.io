---
import PageLayout from '../../components/layout/PageLayout.astro';
import { Badge } from '../../components/ui/Badge';
import { Button } from '../../components/ui/Button';
import { Card } from '../../components/ui/Card';
import { SectionHeader } from '../../components/ui/SectionHeader';
import { servicePages } from '../../config/services-data';
import { CALENDLY_URL } from '../../config/constants';

const sectionClass = "mx-auto w-full max-w-site px-6 py-20 sm:px-8 lg:px-10";

const serviceIcons: Record<string, string> = {
  "ai-web-development-newsletter": `<path d="M4 19V5a2 2 0 0 1 2-2h10l4 4v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/><path d="M8 9h6M8 13h8M8 17h5"/>`,
  "web-project-coaching": `<path d="M21 12a9 9 0 1 1-3.5-7.1L21 4l-1 4h-4"/><path d="M8 12h6"/>`,
  "full-stack-development-day": `<polyline points="7 8 3 12 7 16"/><polyline points="17 8 21 12 17 16"/><line x1="14" y1="5" x2="10" y2="19"/>`,
  "mvp-bootstrapping-workshop": `<path d="M3 3v18h18"/><path d="M7 14l3-4 3 3 4-6"/>`,
  "mvp-development": `<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6v6H9z"/><path d="M3 9h6M15 9h6M9 3v6M9 15v6"/>`,
};

const servicePrices: Record<string, string> = {
  "ai-web-development-newsletter": "from €9 / mo",
  "web-project-coaching": "from €90 / 1h",
  "full-stack-development-day": "from €350 / day",
  "mvp-bootstrapping-workshop": "from €650 / day",
  "mvp-development": "from €4,500",
};

const serviceCtaLabels: Record<string, string> = {
  "ai-web-development-newsletter": "Subscribe →",
  "mvp-development": "Request quote →",
};
---

<PageLayout
  title="Services — fullstackchris.dev"
  description="Full-stack development, project coaching, MVP workshops and an AI web development newsletter. All offers are scoped to specific outcomes."
>
  <!-- Hero -->
  <section class="glow-bg grid-bg relative overflow-hidden border-b border-border pt-32 pb-20 mb-4">
    <div class={sectionClass}>
      <nav class="mb-6 flex items-center gap-2 font-mono text-xs text-low">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <span class="text-secondary">Services</span>
      </nav>
      <h1 class="mt-2 max-w-3xl font-display text-[clamp(2.2rem,5vw,4.2rem)] font-bold leading-[1.02] tracking-normal text-white">
        Five ways to move your web project forward.
      </h1>
      <p class="mt-6 max-w-prose text-[clamp(1rem,1.6vw,1.2rem)] leading-8 text-secondary">
        Whether you have a blurry idea, a blocked codebase or a product to launch — there's an entry point sized to where you are right now.
      </p>
    </div>
  </section>

  <!-- Service rows -->
  <section class={sectionClass} style="padding-top: 0;">
    <div class="mx-auto flex max-w-[1000px] flex-col gap-4">
      {servicePages.map((service) => (
        <Card hover class="flex flex-col gap-5 sm:flex-row sm:items-center sm:gap-6 p-6">
          <div class="grid h-12 w-12 shrink-0 place-items-center rounded-lg border border-accent bg-accent-soft text-accent">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={serviceIcons[service.slug] ?? ''} />
          </div>
          <div class="flex-1">
            <h3 class="font-display text-[1.3rem] font-semibold text-white">{service.title}</h3>
            <p class="mt-1 text-[0.96rem] leading-7 text-secondary">{service.meta.description}</p>
          </div>
          <div class="flex shrink-0 flex-col items-start gap-3 sm:items-end">
            <span class="font-display text-[1rem] font-semibold text-white">{servicePrices[service.slug]}</span>
            <Button href={`/services/${service.slug}`} variant="secondary" size="sm">
              {serviceCtaLabels[service.slug] ?? 'Learn more →'}
            </Button>
          </div>
        </Card>
      ))}
    </div>
  </section>

  <!-- How it fits together -->
  <section class="border-y border-border bg-surface/40">
    <div class={sectionClass}>
      <SectionHeader eyebrow="HOW IT FITS TOGETHER" title="One ladder, not five silos." description="Most clients start small and move up as the project gets clearer. Each step hands off cleanly to the next." />
      <div class="mt-10 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-lg border border-border bg-surface p-5">
          <span class="font-mono text-xs tracking-widest text-accent">01 · CLARIFY</span>
          <h4 class="mt-2 mb-1 font-display text-[1rem] font-semibold text-white">Coaching call</h4>
          <p class="text-[0.85rem] leading-6 text-secondary">Diagnose the blocker and decide the next move.</p>
        </div>
        <div class="rounded-lg border border-border bg-surface p-5">
          <span class="font-mono text-xs tracking-widest text-accent">02 · PLAN</span>
          <h4 class="mt-2 mb-1 font-display text-[1rem] font-semibold text-white">MVP workshop</h4>
          <p class="text-[0.85rem] leading-6 text-secondary">Scope, flows, stack and a realistic roadmap.</p>
        </div>
        <div class="rounded-lg border border-border bg-surface p-5">
          <span class="font-mono text-xs tracking-widest text-accent">03 · BUILD</span>
          <h4 class="mt-2 mb-1 font-display text-[1rem] font-semibold text-white">Development days</h4>
          <p class="text-[0.85rem] leading-6 text-secondary">Focused blocks to ship features and progress.</p>
        </div>
        <div class="rounded-lg border border-border bg-surface p-5">
          <span class="font-mono text-xs tracking-widest text-accent">04 · LAUNCH</span>
          <h4 class="mt-2 mb-1 font-display text-[1rem] font-semibold text-white">Custom MVP</h4>
          <p class="text-[0.85rem] leading-6 text-secondary">Full build, deployment and handover.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="glow-bg grid-bg relative overflow-hidden border-b border-border">
    <div class={sectionClass}>
      <div class="flex flex-col items-center gap-6 py-10 text-center">
        <span class="font-mono text-xs uppercase tracking-widest text-accent">NOT SURE WHICH?</span>
        <h2 class="font-display text-[clamp(1.8rem,3.5vw,2.8rem)] font-semibold leading-tight text-white">
          Start with a 15-minute call.
        </h2>
        <p class="max-w-prose text-lg leading-8 text-secondary">
          Tell me where you are and we'll pick the right entry point together.
        </p>
        <Button href={CALENDLY_URL} variant="primary" size="lg" target="_blank" rel="noopener noreferrer">
          Book a project call →
        </Button>
      </div>
    </div>
  </section>
</PageLayout>
