---
import PageLayout from '../../components/layout/PageLayout.astro';
import { servicePages } from '../../config/services-data';
import { BOOK_CALL_URL } from '../../config/constants';

const sectionMax = "mx-auto w-full max-w-site px-6 sm:px-8 lg:px-10";

// SVG inner paths for each service icon
const serviceIcons: Record<string, string> = {
  "ai-web-development-newsletter":
    `<path d="M4 19V5a2 2 0 0 1 2-2h10l4 4v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/>
     <path d="M8 9h6M8 13h8M8 17h5"/>`,
  "web-project-coaching":
    `<path d="M21 12a9 9 0 1 1-3.5-7.1L21 4l-1 4h-4"/>
     <path d="M8 12h6"/>`,
  "full-stack-development-day":
    `<polyline points="7 8 3 12 7 16"/>
     <polyline points="17 8 21 12 17 16"/>
     <line x1="14" y1="5" x2="10" y2="19"/>`,
  "mvp-bootstrapping-workshop":
    `<path d="M3 3v18h18"/>
     <path d="M7 14l3-4 3 3 4-6"/>`,
  "mvp-development":
    `<rect x="3" y="3" width="18" height="18" rx="2"/>
     <path d="M9 9h6v6H9z"/>
     <path d="M3 9h6M15 9h6M9 3v6M9 15v6"/>`,
};

const servicePrices: Record<string, string> = {
  "ai-web-development-newsletter": "from €9 / mo",
  "web-project-coaching":          "from €90 / 1h",
  "full-stack-development-day":    "from €350 / day",
  "mvp-bootstrapping-workshop":    "from €650 / day",
  "mvp-development":               "from €4,500",
};

const serviceSteps: Record<string, string> = {
  "ai-web-development-newsletter": "00 · Learn",
  "web-project-coaching":          "01 · Clarify",
  "full-stack-development-day":    "03 · Build",
  "mvp-bootstrapping-workshop":    "02 · Plan",
  "mvp-development":               "04 · Launch",
};

const serviceCtaLabels: Record<string, string> = {
  "ai-web-development-newsletter": "Subscribe",
  "mvp-development":               "Request quote",
};

// Ladder nodes (in logical step order)
const ladderNodes = [
  { step: "0", key: "learn",   label: "Learn",    name: "Newsletter",  desc: "Stay sharp on AI web dev, monthly.",
    icon: `<path d="M4 19V5a2 2 0 0 1 2-2h10l4 4v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/><path d="M8 9h6M8 13h8M8 17h5"/>` },
  { step: "1", key: "clarify", label: "Clarify",  name: "Coaching",    desc: "Diagnose the blocker, pick the next move.",
    icon: `<path d="M21 12a9 9 0 1 1-3.5-7.1L21 4l-1 4h-4"/><path d="M8 12h6"/>` },
  { step: "2", key: "plan",    label: "Plan",     name: "Clarity bootstrap", desc: "Scope, flows, stack and a real roadmap.",
    icon: `<path d="M3 3v18h18"/><path d="M7 14l3-4 3 3 4-6"/>` },
  { step: "3", key: "build",   label: "Build",    name: "Dev days",    desc: "Focused blocks that ship features.",
    icon: `<polyline points="7 8 3 12 7 16"/><polyline points="17 8 21 12 17 16"/><line x1="14" y1="5" x2="10" y2="19"/>` },
  { step: "4", key: "launch",  label: "Launch",   name: "Custom MVP",  desc: "Full build, deploy and handover.",
    icon: `<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6v6H9z"/><path d="M3 9h6M15 9h6M9 3v6M9 15v6"/>` },
];
---

<PageLayout
  title="Services — Web Project Coaching, Full-Stack Development, MVP Workshop and Custom MVP | fullstackchris.dev"
  description="Web project coaching, full-stack development days, the AI Clarity Bootstrap Workshop, custom MVP development and a practical AI web development newsletter — React, Node.js, TypeScript and AI-assisted workflows for founders, freelancers and small teams."
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Services — fullstackchris.dev",
    url: "https://fullstackchris.dev/services",
    description: "Coaching, development days, MVP workshops and custom MVP development.",
    itemListElement: servicePages.map((s, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: `https://fullstackchris.dev/services/${s.slug}`,
      name: s.title,
    })),
  }}
>

  <!-- ── HERO ──────────────────────────────────────────────────────────── -->
  <section class="svc-hero relative overflow-hidden" style="isolation:isolate;">
    <!-- Blob field -->
    <div class="bg-field" aria-hidden="true">
      <span class="blob blob-1"></span>
      <span class="blob blob-2"></span>
      <span class="blob blob-3"></span>
    </div>

    <!-- Grid overlay -->
    <div class="absolute inset-0 pointer-events-none z-[1] opacity-40"
         style="background-image:linear-gradient(var(--border) 1px,transparent 1px),linear-gradient(90deg,var(--border) 1px,transparent 1px);background-size:64px 64px;"
         aria-hidden="true"></div>

    <div class={`${sectionMax} relative z-[3]`} style="padding-top:clamp(5rem,8vh,6.5rem);padding-bottom:clamp(2.5rem,4vh,1rem);">
      <!-- Breadcrumb -->
      <nav class="reveal r1 flex items-center gap-2 font-mono text-xs text-low mb-4">
        <a href="/" class="text-secondary transition-colors hover:text-white">Home</a>
        <span class="opacity-50">/</span>
        <span class="text-secondary">Services</span>
      </nav>

      <!-- Eyebrow -->
      <span class="reveal r2 inline-flex items-center gap-[10px] font-mono text-[0.7rem] font-medium tracking-[0.16em] uppercase text-secondary px-[14px] py-[7px] border border-strong rounded-md" style="background:rgba(26,26,32,0.55);backdrop-filter:blur(8px);">
        <span class="pulse-dot"></span>Clarify · Plan · Build · Launch
      </span>

      <!-- Headline -->
      <h1 class="reveal r3 font-display font-bold leading-[0.99] tracking-[-0.035em] mt-4 mb-3" style="font-size:clamp(2.2rem,4.6vw,3.6rem);max-width:19ch;">
        Five ways to move your web project <span style="color:var(--accent-400)">forward.</span>
      </h1>

      <!-- Lead -->
      <p class="reveal r4 text-secondary leading-7 mb-4" style="max-width:54ch;font-size:clamp(0.95rem,1.3vw,1.05rem);">
        Whether you have a blurry idea, a blocked codebase or a product to launch — there's an entry point sized to exactly where you are right now.
      </p>

      <!-- CTAs -->
      <div class="reveal r5 flex flex-wrap gap-3">
        <a class="btn btn-primary-animated inline-flex items-center gap-2 rounded-md border px-5 py-2 font-display font-semibold text-[0.875rem] no-underline transition-all duration-200"
           href={BOOK_CALL_URL}>
          Book a 15-min call <span>→</span>
        </a>
        <a class="btn-grad-hover btn-secondary inline-flex items-center gap-2 rounded-md border border-strong px-5 py-2 font-display font-semibold text-[0.875rem] text-secondary no-underline transition-all duration-200"
           href="#ladder">
          See how it fits together
        </a>
      </div>
    </div>
  </section>

  <!-- ── LADDER ─────────────────────────────────────────────────────────── -->
  <section class="section border-y border-border" id="ladder" style="background:var(--bg-1);">
    <div class={sectionMax}>
      <!-- Ladder head -->
      <div class="text-center mx-auto mb-16" style="max-width:56ch;" data-reveal="fade">
        <span class="font-mono text-[0.62rem] tracking-[0.18em] uppercase text-accent">HOW IT FITS TOGETHER</span>
        <h2 class="font-display font-semibold leading-tight mt-3 mb-3" style="font-size:clamp(1.7rem,2.8vw,2.3rem);">
          One ladder, not five silos.
        </h2>
        <p class="text-secondary text-[0.96rem] leading-relaxed">
          Most clients start small and climb as the project gets clearer. Each step hands off cleanly to the next — no restarting with someone new.
        </p>
      </div>

      <!-- Draw-on-scroll ladder -->
      <div class="ladder" style="max-width:1000px;margin:0 auto;">
        <div class="rail"><div class="rail-fill"></div></div>
        <div class="lnodes">
          {ladderNodes.map((node) => (
            <div class="lnode">
              <span class="marker">
                <span class="knum">{node.step}</span>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" set:html={node.icon} />
              </span>
              <span class="lk">{node.label}</span>
              <span class="ln">{node.name}</span>
              <span class="ld">{node.desc}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── SERVICE LIST ───────────────────────────────────────────────────── -->
  <section class="section">
    <div class={sectionMax}>
      <div class="flex flex-col gap-4 mx-auto" style="max-width:1000px;" data-stagger="90">
        {servicePages.map((service) => {
          const isFlagship = service.slug === 'mvp-development';
          return (
            <a
              class={`svc-row filterable${isFlagship ? ' flagship' : ''}`}
              href={`/services/${service.slug}`}
              data-reveal="left"
            >
              <!-- Icon -->
              <div class="svc-ic">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                     set:html={serviceIcons[service.slug] ?? ''} />
              </div>

              <!-- Meta -->
              <div class="svc-meta">
                <span class="step">{serviceSteps[service.slug]}</span>
                <h3>{service.title}</h3>
                <p>{service.meta.description}</p>
                <div class="tags">
                  {service.hero.primaryCta && (
                    <span class="badge">{service.badge}</span>
                  )}
                  {isFlagship && (
                    <span class="badge badge-accent">
                      <span class="dot"></span>Flagship
                    </span>
                  )}
                </div>
              </div>

              <!-- Price + CTA -->
              <div class="svc-end">
                <span class="price-tag">{servicePrices[service.slug]}</span>
                <span class="go">
                  {serviceCtaLabels[service.slug] ?? 'Learn more'}
                  <span class="ar">→</span>
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────────────── -->
  <section class="section" style="padding-top:0;" id="contact">
    <div class={sectionMax}>
      <div class="text-center border border-accent rounded-[var(--r-xl)] px-8 py-20 mx-auto"
           style="max-width:1000px;background:linear-gradient(150deg,var(--accent-soft) 0%,var(--bg-2) 55%);box-shadow:var(--glow);"
           data-reveal="scale">
        <span class="font-mono text-[0.62rem] tracking-[0.18em] uppercase text-accent">NOT SURE WHICH?</span>
        <h2 class="font-display font-semibold leading-tight mt-4 mb-4 mx-auto"
            style="font-size:clamp(2rem,4vw,3rem);max-width:18ch;">
          Start with a 30-minute call.
        </h2>
        <p class="text-secondary leading-7 mb-8 mx-auto" style="max-width:46ch;">
          Tell me where you are and I'll help you pick the right entry point — no pressure, no jargon.
        </p>
        <a class="btn btn-primary-animated inline-flex items-center gap-2 rounded-md border px-6 py-3 font-display font-semibold text-[0.95rem] no-underline transition-all duration-200"
           href={BOOK_CALL_URL}>
          Book a project call <span>→</span>
        </a>
      </div>
    </div>
  </section>

</PageLayout>

<style>
  .svc-hero { min-height: 50svh; }
  @media (max-width: 700px) { .svc-hero { min-height: 0; } }
  .section { padding: 80px 0; }
  @media (max-width: 700px) { .section { padding: 56px 0; } }
</style>
