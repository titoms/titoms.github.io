---
import PageLayout from '../../components/layout/PageLayout.astro';
import { Badge } from '../../components/ui/Badge';
import { Button } from '../../components/ui/Button';
import { Card } from '../../components/ui/Card';
import { SectionHeader } from '../../components/ui/SectionHeader';
import { servicePages } from '../../config/services-data';
import { CALENDLY_URL } from '../../config/constants';

const sectionClass = "mx-auto w-full max-w-site px-6 py-20 sm:px-8 lg:px-10";
---

<PageLayout
  title="Services — fullstackchris.dev"
  description="Full-stack development, project coaching, MVP workshops and an AI web development newsletter. All offers are scoped to specific outcomes."
>
  <!-- Hero -->
  <section class="glow-bg grid-bg relative overflow-hidden border-b border-border pt-32 pb-20">
    <div class={sectionClass}>
      <Badge variant="accent">Services</Badge>
      <h1 class="mt-6 max-w-3xl font-display text-[clamp(2.2rem,5vw,4.2rem)] font-bold leading-[1.02] tracking-normal text-white">
        Five ways to work together.
      </h1>
      <p class="mt-6 max-w-prose text-[clamp(1rem,1.6vw,1.2rem)] leading-8 text-secondary">
        All offers are scoped to specific outcomes. No vague retainers, no long commitments, no hidden fees. Pick what fits your situation.
      </p>
    </div>
  </section>

  <!-- Service cards -->
  <section class={sectionClass}>
    <div class="grid gap-6 md:grid-cols-2">
      {servicePages.map((service) => (
        <Card hover class="flex flex-col gap-4">
          <Badge variant="accent">{service.badge}</Badge>
          <h2 class="font-display text-2xl font-semibold text-white">{service.hero.h1}</h2>
          <p class="text-[0.95rem] leading-7 text-secondary">{service.meta.description}</p>
          <div class="mt-auto border-t border-border pt-4">
            <Button href={`/services/${service.slug}`} variant="secondary" size="sm">
              See details
            </Button>
          </div>
        </Card>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-border bg-surface/40">
    <div class={sectionClass}>
      <div class="flex flex-col items-center gap-6 py-6 text-center">
        <p class="text-secondary">Not sure which service fits?</p>
        <Button href={CALENDLY_URL} variant="primary" size="lg" target="_blank" rel="noopener noreferrer">
          Book a free call
        </Button>
      </div>
    </div>
  </section>
</PageLayout>
